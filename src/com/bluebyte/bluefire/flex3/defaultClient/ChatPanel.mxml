                    percentWidth="100" percentHeight="100"
                    backgroundAlpha="0" borderThickness="0" left="0"/>
                <mx:Canvas width="18" percentHeight="100" clipContent="true">
                    <mx:Button id="_ChatPanel_Button1" width="22" height="22" top="0" horizontalCenter="0"/>
                    <mx:Button id="_ChatPanel_Button2" width="22" height="22" bottom="23" horizontalCenter="0"/>
                    <mx:CheckBox id="autoScrollBox" bottom="0" horizontalCenter="-1"/>
                </mx:Canvas>
                <bf:CustomList id="whispersList" percentHeight="100" visible="false"
                    labelField="name" top="0" right="0"/>
                <bf:ChatToggleButtonBar id="buttonBar" columnCount="1" focusEnabled="false"
                    percentHeight="100" width="100" top="0" right="0"/>
            </mx:HBox>
        </mx:VBox>
    </mx:Canvas>
    <bf:CustomInput id="chatInput" left="5" right="5" bottom="5" height="30"
        maxChars="500" styleName="chatInput" restrict="^\&lt;"/>
</mx:Canvas>
