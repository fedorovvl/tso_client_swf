<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml">
    <mx:Script><![CDATA[
        import flash.events.Event;
        import mx.containers.Canvas;
        import mx.controls.Image;
        import mx.events.EffectEvent;
        import GUI.Components.LegacyMxmlContent;

        [Embed(source="../../../../../../../../assets/gAssetManager/congen_number_00.png")]
        private var digit0:Class;
        [Embed(source="../../../../../../../../assets/gAssetManager/congen_number_01.png")]
        private var digit1:Class;
        [Embed(source="../../../../../../../../assets/gAssetManager/congen_number_02.png")]
        private var digit2:Class;
        [Embed(source="../../../../../../../../assets/gAssetManager/congen_number_03.png")]
        private var digit3:Class;
        [Embed(source="../../../../../../../../assets/gAssetManager/congen_number_04.png")]
        private var digit4:Class;
        [Embed(source="../../../../../../../../assets/gAssetManager/congen_number_05.png")]
        private var digit5:Class;
        [Embed(source="../../../../../../../../assets/gAssetManager/congen_number_06.png")]
        private var digit6:Class;
        [Embed(source="../../../../../../../../assets/gAssetManager/congen_number_07.png")]
        private var digit7:Class;
        [Embed(source="../../../../../../../../assets/gAssetManager/congen_number_08.png")]
        private var digit8:Class;
        [Embed(source="../../../../../../../../assets/gAssetManager/congen_number_09.png")]
        private var digit9:Class;

        private var isCreated:Boolean = false;
        private var isScrolling:Boolean = false;
        private var layoutHeight:Number = -1;
        private var _targetNumber:int = 0;

        [Bindable]
        public var currentNumber:int = 0;

        public function get targetNumber():int
        {
            return _targetNumber;
        }

        public function set targetNumber(value:int):void
        {
            _targetNumber = Math.max(0, Math.min(9, value));
        }

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            horizontalScrollPolicy = "off";
            verticalScrollPolicy = "off";
            LegacyMxmlContent.createChildren(block0);
            LegacyMxmlContent.createChildren(block1);
            LegacyMxmlContent.createChildren(block2);
            digitAbove.source = digitClass(9);
            digitCurrent.source = digitClass(0);
            digitBelow.source = digitClass(1);
            scrollDown.targets = [block0, block1, block2];
            scrollUp.targets = [block0, block1, block2];
            scrollDown.addEventListener(EffectEvent.EFFECT_END, scrollDownEndHandler);
            scrollUp.addEventListener(EffectEvent.EFFECT_END, scrollUpEndHandler);
            addEventListener(Event.ENTER_FRAME, enterFrameHandler);
            isCreated = true;
        }

        override protected function updateDisplayList(unscaledWidth:Number, unscaledHeight:Number):void
        {
            super.updateDisplayList(unscaledWidth, unscaledHeight);
            if (layoutHeight == unscaledHeight)
            {
                return;
            };
            layoutHeight = unscaledHeight;
            block0.height = unscaledHeight;
            block1.height = unscaledHeight;
            block2.height = unscaledHeight;
            block0.y = -unscaledHeight;
            block1.y = 0;
            block2.y = unscaledHeight;
            scrollDown.yBy = unscaledHeight;
            scrollUp.yBy = -unscaledHeight;
        }

        private function enterFrameHandler(event:Event):void
        {
            if (!isCreated || isScrolling || currentNumber == _targetNumber || layoutHeight <= 0)
            {
                return;
            };
            if (currentNumber > _targetNumber)
            {
                if (Math.abs(currentNumber - _targetNumber) < 5)
                    moveLower();
                else
                    moveHigher();
            }
            else if (Math.abs(_targetNumber - currentNumber) < 5)
            {
                moveHigher();
            }
            else
            {
                moveLower();
            };
        }

        private function moveHigher():void
        {
            isScrolling = true;
            scrollUp.end();
            scrollUp.play();
        }

        private function moveLower():void
        {
            isScrolling = true;
            scrollDown.end();
            scrollDown.play();
        }

        private function scrollUpEndHandler(event:EffectEvent):void
        {
            var block:Canvas = event.effectInstance.target as Canvas;
            if (block != null && block.y < -layoutHeight)
            {
                block.y = layoutHeight;
                (block.getChildAt(0) as Image).source = digitClass(getUpNumber());
            };
            isScrolling = false;
        }

        private function scrollDownEndHandler(event:EffectEvent):void
        {
            var block:Canvas = event.effectInstance.target as Canvas;
            if (block != null && block.y > layoutHeight)
            {
                block.y = -layoutHeight;
                (block.getChildAt(0) as Image).source = digitClass(getDownNumber());
            };
            isScrolling = false;
        }

        private function getUpNumber():int
        {
            var next:int = (currentNumber + 2) % 10;
            currentNumber = (currentNumber + 1) % 10;
            return next;
        }

        private function getDownNumber():int
        {
            var next:int = (currentNumber + 8) % 10;
            currentNumber = (currentNumber + 9) % 10;
            return next;
        }

        private function digitClass(value:int):Class
        {
            return ([digit0, digit1, digit2, digit3, digit4,
                digit5, digit6, digit7, digit8, digit9][value] as Class);
        }
    ]]></mx:Script>

    <mx:Move id="scrollDown" duration="100" />
    <mx:Move id="scrollUp" duration="100" />

    <mx:Canvas id="block0" x="0" percentWidth="100">
        <mx:Image id="digitAbove" x="0" y="0" percentWidth="100" percentHeight="100" />
    </mx:Canvas>
    <mx:Canvas id="block1" x="0" percentWidth="100">
        <mx:Image id="digitCurrent" x="0" y="0" percentWidth="100" percentHeight="100" />
    </mx:Canvas>
    <mx:Canvas id="block2" x="0" percentWidth="100">
        <mx:Image id="digitBelow" x="0" y="0" percentWidth="100" percentHeight="100" />
    </mx:Canvas>
</mx:Canvas>
