        private function display(event:Event=null):void
        {
            var subMap:Dictionary;
            var subQuestVO:dQuestElementVO;
            var subRenderer:QuestListItemRenderer;
            var key:String;
            var questVO:dQuestElementVO;
            var cancelable:Boolean;
            var rankPosition:int;
            var readyToSubmit:Boolean;
            var failed:Boolean;
            var lastPartial:Boolean;
            var guildVO:dGuildVO;
            var memberRankId:int;
            var member:dGuildPlayerListItemVO;
            var rank:dGuildRankListItemVO;
            var adventureDef:cAdventureDefinition;
            var quality:int;
            removeEventListener(FlexEvent.CREATION_COMPLETE, this.display);
            this.expandToHeight = 29;
            if (this.subQuests.length == 0)
            {
                this.btnItem.normalStyle = "QuestItemBgNormal";
                this.btnItem.hoverStyle = "QuestItemBgNormal";
                this.btnItem.selectedStyle = "QuestItemBgSelected";
                this.mainQuest = false;
                for (key in this._itemRendererMap)
                {
                    this.list.removeChild(this._itemRendererMap[key]);
                    delete this._itemRendererMap[key];
                };
            }
            else
            {
                this.btnItem.normalStyle = "QuestItemBgHead";
                this.btnItem.hoverStyle = "QuestItemBgHead";
                this.btnItem.selectedStyle = "QuestItemBgHeadSelected";
                this.mainQuest = true;
                subMap = new Dictionary();
                this.subQuests.sort(this.compareQuest);
                for each (subQuestVO in this.subQuests)
                {
                    key = (subQuestVO.getQuestName_string() + subQuestVO.GetUniqueId().toKeyString());
                    if (this._itemRendererMap[key])
                    {
                        subRenderer = this._itemRendererMap[key];
                    }
                    else
                    {
                        subRenderer = new QuestListItemRenderer();
                        this._itemRendererMap[key] = subRenderer;
                        this.list.addChild(subRenderer);
