                    this.expandToHeight = (this.expandToHeight + (int(this.list.getStyle("verticalGap")) + 29));
                    subRenderer.data = subQuestVO;
                    subRenderer.subQuest = true;
                    subRenderer.callLater(subRenderer.refresh);
                    subMap[key] = subQuestVO;
                };
                for (key in this._itemRendererMap)
                {
                    if (!subMap[key])
                    {
                        this.list.removeChild(this._itemRendererMap[key]);
                        delete this._itemRendererMap[key];
                    }
                    else
                    {
                        this._itemRendererMap[key].refresh();
                    };
                };
            };
            if ((data is dQuestElementVO))
            {
                questVO = (data as dQuestElementVO);
