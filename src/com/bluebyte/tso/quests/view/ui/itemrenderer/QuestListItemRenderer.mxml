        public function refresh():void
        {
            if (this.btnItem)
            {
                this.display();
            }
            else
            {
                addEventListener(FlexEvent.CREATION_COMPLETE, this.display);
            };
        }

        private function checkboxClicked(event:MouseEvent):void
        {
            event.stopImmediatePropagation();
            var trackEvent:TrackMissionEvent = new TrackMissionEvent(TrackMissionEvent.TRACK_MISSION, true);
            trackEvent.item = data;
            trackEvent.track = this.btnItem.checkboxSelected;
            dispatchEvent(trackEvent);
        }

        private function expandParent():void
        {
            var group:QuestListGroupItemRenderer = (parentDocument as QuestListGroupItemRenderer);
            group.expandToHeight = (group.expandToHeight + (this.list.numChildren * (int(this.list.getStyle("verticalGap")) + 29)));
            group.collapse.end();
            group.expand.end();
            group.expand.play();
        }

        private function collapseClickHandler(event:MouseEvent):void
        {
            if (!this.collapsed)
            {
                this.expand.end();
                this.collapse.play();
            }
            else
            {
                this.collapse.end();
                this.expand.play();
            };
            this.collapsed = (!(this.collapsed));
            event.stopImmediatePropagation();
            if (!this.collapsed)
            {
                dispatchEvent(new EffectEvent(EffectEvent.EFFECT_START, true));
            };
        }

        private function deleteClicked(event:MouseEvent):void
        {
            event.stopImmediatePropagation();
            var cancelEvent:ItemClickEvent = new ItemClickEvent("cancelQuest", true);
            cancelEvent.item = data;
            dispatchEvent(cancelEvent);
        }

        private function compareQuest(first:dQuestElementVO, second:dQuestElementVO):int
        {
            if (first.mUniqueID.greater(second.mUniqueID))
            {
                return (1);
            };
            if (first.mUniqueID.eq(second.mUniqueID))
            {
                return (0);
            };
            return (-1);
        }

