                        };
                    };
                };
                this.btnItem.deleteVisible = cancelable;
                this.tracked = questVO.mIsTrackedMission;
                readyToSubmit = false;
                failed = (questVO.mQuestMode == QuestManagerStatic.QUEST_MODE_QUEST_FAILED);
                if (questVO.mQuestDefinition.specialType_string == QuestManagerStatic.SPECIAL_TYPE_GUILD_QUEST)
