                        this.btnItem.iconImage = gAssetManager.ColorFilterImage(gAssetManager.GetBitmap(("adventureType" + adventureDef.GetType_string())), cAdventureDefinition.GetDifficultyColor(adventureDef.GetDifficulty()));
