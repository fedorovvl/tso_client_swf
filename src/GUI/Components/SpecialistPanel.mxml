        private function syncProgress(event:Event = null):void
        {
            var value:* = _progressProxy ? _progressProxy.progress : undefined;
            progress.value = ((value == undefined) ? 0 : value);
            progress.visible = _progressVisible;
            generalRecovering.visible = _progressVisible;
            admiralRecovering.visible = _progressVisible;
            generalStatusPanel.progressProxy = _progressProxy;
            admiralStatusPanel.progressProxy = _progressProxy;
        }

        private function onProgressProxyChanged(event:PropertyChangeEvent):void
