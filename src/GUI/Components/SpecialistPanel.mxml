        [Bindable(event="propertyChange")]
        public function get progressProxy():ObjectProxy
        {
            return _progressProxy;
        }

        public function set progressProxy(value:ObjectProxy):void
        {
            var old:Object = _progressProxy;
            if (old !== value)
            {
                if (_progressProxy)
                    _progressProxy.removeEventListener(PropertyChangeEvent.PROPERTY_CHANGE, onProgressProxyChanged);
                _progressProxy = value;
                if (_progressProxy)
                    _progressProxy.addEventListener(PropertyChangeEvent.PROPERTY_CHANGE, onProgressProxyChanged, false, 0, true);
                dispatchEvent(PropertyChangeEvent.createUpdateEvent(this, "progressProxy", old, value));
                syncProgress();
            }
        }

