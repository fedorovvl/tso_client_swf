        private function prop(target:Object, name:String, value:Object):SetProperty
        {
            var set:SetProperty = new SetProperty();
            set.target = target;
            set.name = name;
            set.value = value;
            return set;
        }

        private function buildStates():void
        {
            var general:State = new State();
            general.name = "General";
            general.overrides = [prop(this, "width", 603), prop(this, "height", 385),
                prop(specHeader, "height", 60),
                setStyleOf(specHeader, "left", 185), setStyleOf(specHeader, "top", 77),
                prop(hr1, "visible", true), prop(hr1, "width", 390), prop(hr1, "x", 190),
                prop(skills, "visible", true), prop(skills, "x", 190), prop(skills, "width", 400),
                prop(bronzeSkill, "width", 87), prop(silverSkill, "width", 87), prop(goldSkill, "width", 95),
                prop(hr2, "visible", true), prop(hr2, "width", 390), prop(hr2, "x", 190),
                drop(confirmFooter),
                addTo(generalLeftColumn), addTo(generalRightColumn)];
            stateGeneral = general;
            var admiral:State = new State();
            admiral.name = "Admiral";
            admiral.overrides = [prop(this, "width", 650), prop(this, "height", 502),
                drop(confirmFooter),
                addTo(admiralLeftColumn), addTo(admiralBottom), addTo(admiralRightColumn)];
            stateAdmiral = admiral;
            var explorer:State = new State();
            explorer.name = "Explorer";
            explorer.overrides = [prop(this, "height", 396),
                prop(hr1, "visible", true), prop(hr2, "visible", true), prop(skills, "visible", true),
                setStyleOf(specHeader, "top", 77),
                addTo(explorerCommandsHeader), addTo(subContentExplorerBase),
                addTo(subContentExplore), addTo(subContentFindAdventure),
                addTo(subContentFindTreasure), addTo(explorerCostsBox, costsHolder),
                addTo(subContentFindExpedition)];
            stateExplorer = explorer;
            var geologist:State = new State();
            geologist.name = "Geologist";
            geologist.overrides = [prop(this, "height", 524),
                prop(hr1, "visible", true), prop(hr2, "visible", true), prop(skills, "visible", true),
                setStyleOf(specHeader, "top", 77),
                addTo(geologistCommandsHeader), addTo(geologistDepositList),
                addTo(geologistTaskDuration, costsHolder)];
            stateGeologist = geologist;
            states = [general, admiral, explorer, geologist];
        }

