        private function colorFilter(param:String):ColorMatrixFilter
        {
            return coloringFilter(SkillDefinition.getColorByType(param));
        }

        public function getAllItems(param:String):Vector.<DisplayObject>
        {
            var list:ArrayCollection = null;
            var index:int = 0;
            if (param == null)
                return null;
            var result:Vector.<DisplayObject> = new Vector.<DisplayObject>();
            if (this.manageArmyList != null && this.manageArmyList.dataProvider != null)
            {
                list = ArrayCollection(this.manageArmyList.dataProvider);
                index = 0;
                while (index < list.length)
                {
                    if ("Army" + list[index].name_string == param)
                        result.push(this.manageArmyList.indexToItemRenderer(index) as DisplayObject);
                    index++;
                }
            }
            if (hasOwnProperty(param))
                result.push(this[param]);
            return result;
        }

        public function getFirstItem(param:String):DisplayObject
        {
            var list:ArrayCollection = null;
            var index:int = 0;
            if (param == null)
                return null;
            if (this.manageArmyList != null && this.manageArmyList.dataProvider != null)
            {
                list = ArrayCollection(this.manageArmyList.dataProvider);
                index = 0;
                while (index < list.length)
                {
                    if ("Army" + list[index].name_string == param)
                        return this.manageArmyList.indexToItemRenderer(index) as DisplayObject;
                    index++;
                }
            }
            if (hasOwnProperty(param))
                return this[param];
            return null;
        }

        public function set busy(value:Boolean):void
        {
            switch (this.currentState)
            {
                case "TransporterGeneral":
