        { var value:* = visible ? 197 : 189; return value == undefined ? null : String(value); }

        private function updateDigit2(event:Event = null):void
        { digit2.setStyle("left", digit2Left(digit1.visible)); }

        public function onBtnClaimRewards_toolTipCreate(event:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_ERROR_string, event, (!(btnClaimRewards.enabled)));
        }
    ]]></mx:Script>

