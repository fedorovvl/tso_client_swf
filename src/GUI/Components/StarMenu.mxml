<?xml version="1.0" encoding="utf-8"?>
<gui:BasicPanel xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:gui="GUI.Components.*"
    width="557" height="400" implements="GUI.Components.IGUIList">
    <mx:Script><![CDATA[
        import flash.events.Event;
        import flash.display.DisplayObject;
        import mx.core.ClassFactory;
        import mx.collections.ArrayCollection;
        import mx.events.PropertyChangeEvent;
        import mx.events.FlexEvent;
        import GUI.Assets.gAssetManager;
        import GUI.Loca.cLocaManager;
        import GUI.Components.ItemRenderer.StarMenuItemRenderer;
        import GUI.Components.ItemRenderer.StarMenuNullItemRenderer;
        import BuffSystem.cBuff;
        import Specialists.cSpecialist;
        import Enums.SPECIALIST_TYPE;
        import flash.events.MouseEvent;

        private static const MIN_STAR_MENU_WIDTH:Number = 557;
        private static const MIN_STAR_MENU_HEIGHT:Number = 400;
        private var resizeStartMouseX:Number;
        private var resizeStartMouseY:Number;
        private var resizeStartWidth:Number;
        private var resizeStartHeight:Number;
        private var resizeActive:Boolean = false;

        [Embed(source="../../../assets/vector/StarMenu/_embed_mxml__105903956.swf", symbol="GUI.Components.StarMenu__embed_mxml__105903956")]
        private var toolbarSkin:Class;
        private var sortAscending:Boolean = true;
        // Лока недоступна в конструкторе (панель создаётся до загрузки loca):
        // строится лениво в updateTexts() по IsInitialized/languageChanged.
        private var sortOptions:ArrayCollection;

        [Bindable(event="propertyChange")]
        public function get comboBoxData():ArrayCollection { return sortOptions; }
        public function set comboBoxData(value:ArrayCollection):void
        {
            if (sortOptions == value) return;
            var previous:ArrayCollection = sortOptions;
            sortOptions = value;
            if (sortCombo) sortCombo.dataProvider = value;
            dispatchEvent(PropertyChangeEvent.createUpdateEvent(this, "comboBoxData", previous, value));
        }

        public function get ascending():Boolean { return sortAscending; }
        public function set ascending(value:Boolean):void
        {
            sortAscending = value;
            updateSortArrow();
        }

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            LegacyMxmlContent.createChildren(toolbar);
            toolbar.setStyle("backgroundImage", toolbarSkin);
            sortCombo.itemRenderer = new ClassFactory(StarMenuComboBoxItem);
            sortCombo.dataProvider = sortOptions;
            searchIcon.source = gAssetManager.GetClass("SearchBtnIcon");
            searchInput.addEventListener(Event.CHANGE, updateSearchClearButton);
            searchClearButton.addEventListener(MouseEvent.CLICK, clearSearch);
            updateSearchClearButton();
            itemList.nullItemRenderer = new ClassFactory(StarMenuNullItemRenderer);
            itemList.itemRenderer = new ClassFactory(StarMenuItemRenderer);
            for each (var padding:String in ["paddingLeft", "paddingRight", "paddingTop", "paddingBottom"])
                itemList.setStyle(padding, 0);
            dragon.addEventListener("resize", updateDragonPosition);
            headline.addEventListener("resize", updateDragonPosition);
            cLocaManager.GetInstance().addEventListener("languageChanged", updateTexts, false, 0, true);
            updateTexts();
            updateSortArrow();
            updateDragonPosition();
            addEventListener(FlexEvent.CREATION_COMPLETE, activateResizeHandle, false, 0, true);
        }

        private function updateSearchClearButton(event:Event=null):void
        {
            searchClearButton.visible = searchInput.text.length > 0;
        }

        private function clearSearch(event:MouseEvent):void
        {
            searchInput.text = "";
            searchInput.dispatchEvent(new Event(Event.CHANGE));
            searchInput.setFocus();
        }

        private function activateResizeHandle(event:FlexEvent):void
        {
            removeEventListener(FlexEvent.CREATION_COMPLETE, activateResizeHandle);
            drawResizeHandle();
            resizeHandle.addEventListener(MouseEvent.MOUSE_DOWN, startResize, false, 0, true);
        }

        private function drawResizeHandle():void
        {
            resizeHandle.graphics.clear();
            resizeHandle.graphics.beginFill(0x302719, 0.92);
            resizeHandle.graphics.drawRect(0, 0, 16, 16);
            resizeHandle.graphics.endFill();
            resizeHandle.graphics.lineStyle(2, 0xD6A94C, 1);
            resizeHandle.graphics.moveTo(5, 13);
            resizeHandle.graphics.lineTo(13, 5);
            resizeHandle.graphics.moveTo(9, 13);
            resizeHandle.graphics.lineTo(13, 9);
        }

        private function startResize(event:MouseEvent):void
        {
            event.stopImmediatePropagation();
            if (stage == null) return;
            resizeActive = true;
            resizeStartMouseX = event.stageX;
            resizeStartMouseY = event.stageY;
            resizeStartWidth = width;
            resizeStartHeight = height;
            stage.addEventListener(MouseEvent.MOUSE_MOVE, resizePanel, false, 0, true);
            stage.addEventListener(MouseEvent.MOUSE_UP, stopResize, false, 0, true);
            stage.addEventListener(Event.MOUSE_LEAVE, stopResize, false, 0, true);
        }

        private function resizePanel(event:MouseEvent):void
        {
            if (!resizeActive || stage == null) return;
            var maximumWidth:Number = Math.max(MIN_STAR_MENU_WIDTH, stage.stageWidth - x);
            var maximumHeight:Number = Math.max(MIN_STAR_MENU_HEIGHT, stage.stageHeight - y);
            width = Math.min(maximumWidth, Math.max(MIN_STAR_MENU_WIDTH, resizeStartWidth + event.stageX - resizeStartMouseX));
            height = Math.min(maximumHeight, Math.max(MIN_STAR_MENU_HEIGHT, resizeStartHeight + event.stageY - resizeStartMouseY));
            buttonBar.minWidth = 0;
            buttonBar.invalidateSize();
            buttonBar.invalidateDisplayList();
            event.updateAfterEvent();
        }

        private function stopResize(event:Event = null):void
        {
            resizeActive = false;
            if (stage == null) return;
            stage.removeEventListener(MouseEvent.MOUSE_MOVE, resizePanel);
            stage.removeEventListener(MouseEvent.MOUSE_UP, stopResize);
            stage.removeEventListener(Event.MOUSE_LEAVE, stopResize);
        }

        private function updateSortArrow():void
        {
            if (!btnArrow) return;
            var prefix:String = sortAscending ? "ArrowSmallN" : "ArrowSmallS";
            btnArrow.setStyle("upSkin", gAssetManager.GetClass(prefix + "Up"));
            btnArrow.setStyle("overSkin", gAssetManager.GetClass(prefix + "Over"));
            btnArrow.setStyle("downSkin", gAssetManager.GetClass(prefix + "Up"));
        }

        private function updateTexts(event:Event = null):void
        {
            if (!cLocaManager.GetInstance().IsInitialized()) return;
            label = cLocaManager.GetInstance().getLabel("StarMenu");
            btnArrow.toolTip = cLocaManager.GetInstance().getLabel("ChangeSortingOrder");
            if (sortOptions == null)
            {
                comboBoxData = new ArrayCollection([
                    {label:cLocaManager.GetInstance().getLabel("Default"), data:0},
                    {label:cLocaManager.GetInstance().getLabel("Name"), data:1},
                    {label:cLocaManager.GetInstance().getLabel("Date"), data:2},
                    {label:cLocaManager.GetInstance().getLabel("Type"), data:3},
                    {label:cLocaManager.GetInstance().getLabel("Amount"), data:4}
                ]);
            }
            if (event && sortOptions)
            {
                var names:Array = ["Default", "Name", "Date", "Type", "Amount"];
                for each (var option:Object in sortOptions)
                    if (option.data >= 0 && option.data < names.length)
                        option.label = cLocaManager.GetInstance().getLabel(names[option.data]);
                sortOptions.refresh();
            }
        }

        private function updateDragonPosition(event:Event = null):void
        {
            dragon.setStyle("top", -dragon.height - headline.height);
        }

        private function matchesItem(item:Object, type:String):Boolean
        {
            if (item is cBuff) return cBuff(item).GetResourceName_string() == type;
            if (item is cSpecialist) return SPECIALIST_TYPE.toString(cSpecialist(item).GetType()) == type;
            return false;
        }

        public function getAllItems(type:String):Vector.<DisplayObject>
        {
            var result:Vector.<DisplayObject> = new Vector.<DisplayObject>();
            var items:ArrayCollection = itemList ? itemList.dataProvider as ArrayCollection : null;
            if (items)
                for (var index:int = 0; index < items.length; index++)
                {
                    if (type == null || items[index] == null) break;
                    if (matchesItem(items[index], type))
                        result.push(itemList.indexToItemRenderer(index) as DisplayObject);
                }
            return result;
        }

        public function getFirstItem(type:String):DisplayObject
        {
            var items:ArrayCollection = itemList ? itemList.dataProvider as ArrayCollection : null;
            if (items)
                for (var index:int = 0; index < items.length; index++)
                {
                    if (type == null || items[index] == null) break;
                    if (matchesItem(items[index], type))
                        return itemList.indexToItemRenderer(index) as DisplayObject;
                }
            return null;
        }
    ]]></mx:Script>
    <gui:subComponents>
        <mx:Array>
            <mx:Image id="dragon" horizontalCenter="0" />
            <mx:Canvas id="toolbar" mouseEnabled="true" height="30" percentWidth="100" left="5" right="5" backgroundSize="100%">
                <mx:HBox id="sortingControls" mouseEnabled="true" verticalAlign="middle" left="0" horizontalGap="5">
                    <mx:ComboBox id="sortCombo" width="150" selectedIndex="0" styleName="ComboBox" rowCount="6" />
                    <gui:StandardButton id="btnArrow" label="" labelPlacement="left" width="20" />
                </mx:HBox>
                <mx:HBox id="searchControls" mouseEnabled="true" verticalAlign="middle" right="5" horizontalGap="5">
                    <mx:Canvas id="searchField" width="200" height="20" horizontalScrollPolicy="off" verticalScrollPolicy="off">
                        <gui:CustomTextInput id="searchInput" styleName="standardInput" height="20" width="200" paddingRight="22" />
                        <mx:Button id="searchClearButton" styleName="closeSmall" width="13" height="12" right="4" top="4" focusEnabled="false" />
                    </mx:Canvas>
                    <mx:Image id="searchIcon" />
                </mx:HBox>
            </mx:Canvas>
            <gui:CustomTileList id="itemList" rowHeight="70" columnWidth="56" useRollOver="false" borderThickness="0" backgroundAlpha="0" left="11" right="10" top="30" bottom="59" />
            <mx:Canvas id="separator" styleName="hr" height="3" left="2" right="2" bottom="54" />
            <gui:CustomToggleButtonBar id="buttonBar" minWidth="0" buttonStyleName="tab" selectedButtonTextStyleName="tabSelected" height="27" bottom="0" left="5" right="5" />
            <mx:Canvas id="resizeHandle" width="16" height="16" right="1" bottom="1" buttonMode="true" useHandCursor="true" />
        </mx:Array>
    </gui:subComponents>
</gui:BasicPanel>
