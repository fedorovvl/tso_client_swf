        private function makePointerState(name:String, target:Object):State
        {
            var state:State = new State();
            state.name = name;
            var show:SetProperty = new SetProperty();
            show.target = target;
            show.name = "visible";
            show.value = true;
            var layout:SetProperty = new SetProperty();
            layout.target = target;
            layout.name = "includeInLayout";
            layout.value = true;
            state.overrides = [show, layout];
            return state;
        }

        private function buildStates():void
        {
