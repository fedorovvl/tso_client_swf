            </mx:Canvas>
            <mx:Canvas id="rankCanvas" top="66" left="8" right="10" bottom="15">
                <mx:TileList id="rankList" top="0" bottom="0" left="0" right="0" borderStyle="none" backgroundAlpha="0" useRollOver="false" columnWidth="85" rowHeight="94" horizontalScrollPolicy="off" verticalScrollPolicy="off" maxColumns="8" selectable="false" maxRows="4" />
            </mx:Canvas>
            <mx:Canvas id="overviewCanvas" top="0" right="0" left="0" bottom="0">
                <gui:PvPTierSection id="pvpTier1" width="160" height="110" top="82" left="50" />
                <gui:PvPTierSection id="pvpTier2" width="160" height="110" top="82" left="210" />
                <gui:PvPTierSection id="pvpTier3" width="160" height="110" top="82" left="370" />
                <gui:PvPTierSection id="pvpTier4" width="45" height="110" top="82" left="530" />
                <gui:CustomLabel id="tier1StartLabel" height="15" text="0" top="127" left="45" color="0xFFFFFF" />
                <gui:CustomLabel id="tier2StartLabel" height="15" text="10" top="127" left="203" color="0xFFFFFF" />
                <gui:CustomLabel id="tier3StartLabel" height="15" text="20" top="127" left="362" color="0xFFFFFF" />
                <gui:CustomLabel id="tier4StartLabel" height="15" text="30" top="127" left="521" color="0xFFFFFF" />
                <gui:CustomLabel id="unlocksListLabel" width="350" height="20" color="0xFFFFFF" top="210" left="50" textAlign="left" />
                <quest:QuestRewardList id="unlockList" width="178" height="100" horizontalScrollPolicy="off" top="230" left="50" />
                <mx:Canvas id="achievementButtonCanvas" width="150" height="100" horizontalScrollPolicy="off" verticalScrollPolicy="off" top="350" left="50">
                    <mx:VBox left="0" right="0" top="0" bottom="0" horizontalAlign="center" verticalGap="1">
                        <gui:StandardButton id="achievementsButton" height="50" percentWidth="100" textAlign="center" />
                    </mx:VBox>
                </mx:Canvas>
                <mx:Canvas id="pvpBuildingButtonCanvas" width="150" height="100" horizontalScrollPolicy="off" verticalScrollPolicy="off" top="350" left="225">
                    <mx:VBox left="0" right="0" top="0" bottom="0" horizontalAlign="center" verticalGap="1">
                        <gui:StandardButton id="pvpBuildingButton" height="50" percentWidth="100" textAlign="center" />
                    </mx:VBox>
                </mx:Canvas>
            </mx:Canvas>
        </mx:Canvas>
    </mx:Canvas>
    <mx:Canvas id="top" width="807" height="201" mouseEnabled="false" styleName="pvpRankTop" left="10" top="0" horizontalScrollPolicy="off" verticalScrollPolicy="off" />
    <mx:Image id="digit1" top="28" left="378" />
    <mx:Image id="digit2" top="28" left="403" />
    <mx:Canvas id="footer" height="60" styleName="questPanelFooterReward" left="28" right="190" bottom="0">
        <gui:StandardButton id="okButton" width="140" height="28" horizontalCenter="0" bottom="11" />
    </mx:Canvas>
    <gui:TSOImage id="blackKnightImageGlow" width="529" height="520" mouseEnabled="false" right="0" bottom="30" />
    <gui:TSOImage id="blackKnightImage" width="529" height="520" mouseEnabled="false" right="0" bottom="30" />
    <gui:CloseButton id="closeButton" width="25" height="23" right="199" top="67" />
    <gui:StandardButton id="archiveButton" width="30" height="30" left="640" top="217" />
    <mx:Canvas id="progressBarTooltipZone" height="23" top="120" left="130" right="220" backgroundAlpha="0" />
</mx:Canvas>
