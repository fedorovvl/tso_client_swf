<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:gui="GUI.Components.*"
    xmlns:quest="com.bluebyte.tso.quests.view.ui.component.*"
    width="983" height="584">
    <mx:Script><![CDATA[
        import Enums.LOCA_GROUP;
        import GUI.Assets.gAssetManager;
        import GUI.Components.ItemRenderer.PvPRankItemRenderer;
        import GUI.Components.ItemRenderer.SideTabItemRenderer;
        import GUI.Components.ToolTips.cToolTipUtil;
        import GUI.Loca.cLocaManager;
        import flash.events.Event;
        import mx.core.ClassFactory;
        import mx.events.ToolTipEvent;
        import mx.states.SetProperty;
        import mx.states.State;

        public var overviewState:State;
        public var ranksState:State;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            setStyle("horizontalCenter", "50");
            setStyle("verticalCenter", "-20");
            this.visible = false;
            LegacyMxmlContent.createChildren(leftColumn);
            LegacyMxmlContent.createChildren(rightColumn);
            LegacyMxmlContent.createChildren(footer);
            tabContainer.itemRenderer = new ClassFactory(SideTabItemRenderer);
            rankList.itemRenderer = new ClassFactory(PvPRankItemRenderer);
            achievementsButton.setStyle("icon", gAssetManager.GetClass("AchievementsCompletedAvatarMessageIcon"));
            pvpBuildingButton.setStyle("icon", gAssetManager.GetClass("IconWaterCastle"));
            okButton.setStyle("icon", gAssetManager.GetClass("ButtonIconOK"));
            archiveButton.setStyle("icon", gAssetManager.GetClass("DepositQuestionIcon"));
            blackKnightImageGlow.source = gAssetManager.GetClass("ProgressionBlackKnightGlowOverview");
            blackKnightImage.source = gAssetManager.GetClass("ProgressionBlackKnight");
            progressBarTooltipZone.toolTip = cToolTipUtil.PVP_XP;
            progressBarTooltipZone.addEventListener(ToolTipEvent.TOOL_TIP_CREATE, __progressBarTooltipZone_toolTipCreate);
            overviewCanvas.addEventListener("show", updateLayouts);
            overviewCanvas.addEventListener("hide", updateLayouts);
            blackKnightImageGlow.addEventListener("show", updateLayouts);
            blackKnightImageGlow.addEventListener("hide", updateLayouts);
            blackKnightImage.addEventListener("show", updateLayouts);
            blackKnightImage.addEventListener("hide", updateLayouts);
            digit1.addEventListener("show", updateLayouts);
            digit1.addEventListener("hide", updateLayouts);
            updateLayouts();
            buildStates();
            currentState = "overview";
            refreshLabels();
            cLocaManager.GetInstance().addEventListener("languageChanged", refreshLabels, false, 0, true);
        }

        private function syncIncludeInLayout(visible:Boolean):Boolean
        {
            return visible;
        }

        private function digit2Left(digit1Visible:Boolean):int
        {
            return digit1Visible ? 403 : 390;
        }

        private function updateLayouts(event:Event = null):void
        {
            overviewCanvas.includeInLayout = syncIncludeInLayout(overviewCanvas.visible);
            blackKnightImageGlow.includeInLayout = syncIncludeInLayout(blackKnightImageGlow.visible);
            blackKnightImage.includeInLayout = syncIncludeInLayout(blackKnightImage.visible);
            digit2.setStyle("left", String(digit2Left(digit1.visible)));
        }

        private function makeVisible(target:Object, value:Boolean):SetProperty
        {
            var sp:SetProperty = new SetProperty();
            sp.target = target;
            sp.name = "visible";
            sp.value = value;
            return sp;
        }

        private function buildStates():void
        {
            var overview:State = new State();
            overview.name = "overview";
            overview.overrides = [
                makeVisible(overviewCanvas, true),
                makeVisible(blackKnightImage, true),
                makeVisible(blackKnightImageGlow, true),
                makeVisible(overviewProgressContent, true),
                makeVisible(archiveButton, true),
                makeVisible(ranksProgressContent, false),
                makeVisible(rankCanvas, false),
                makeVisible(progressBarTooltipZone, false)
            ];
            overviewState = overview;
            var ranks:State = new State();
            ranks.name = "ranks";
            ranks.overrides = [
                makeVisible(overviewCanvas, false),
                makeVisible(blackKnightImage, false),
                makeVisible(blackKnightImageGlow, false),
                makeVisible(overviewProgressContent, false),
                makeVisible(archiveButton, false),
                makeVisible(ranksProgressContent, true),
                makeVisible(rankCanvas, true),
                makeVisible(progressBarTooltipZone, true)
            ];
            ranksState = ranks;
            states = [overview, ranks];
        }

        private function refreshLabels(event:Event = null):void
        {
            if (!cLocaManager.GetInstance().IsInitialized()) return;
            var text:*;
            text = cLocaManager.GetInstance().getLabel("pvpOverview");
            overviewProgressTitle.text = ((text == undefined) ? null : String(text));
            text = cLocaManager.GetInstance().getLabel("expeditionUnlocks");
            unlocksListLabel.text = ((text == undefined) ? null : String(text));
            text = ((cLocaManager.GetInstance().GetText(LOCA_GROUP.ACHIEVEMENT_LABELS, "PvP") + " ") + cLocaManager.GetInstance().getLabel("Achievements"));
            achievementsButton.toolTip = ((text == undefined) ? null : String(text));
            text = cLocaManager.GetInstance().GetText(LOCA_GROUP.BUILDINGS, "pvp_progression_building");
            pvpBuildingButton.toolTip = ((text == undefined) ? null : String(text));
        }

        public function __progressBarTooltipZone_toolTipCreate(event:ToolTipEvent):void
        {
            progressBarTooltipZone_toolTipCreateHandler(event);
        }

        protected function progressBarTooltipZone_toolTipCreateHandler(event:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(cToolTipUtil.PVP_XP, event);
        }
    ]]></mx:Script>

    <mx:Canvas id="leftColumn" width="150" top="91" left="0" bottom="40" backgroundAlpha="0">
