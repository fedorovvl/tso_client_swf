    <mx:Canvas id="rightColumn" top="91" left="70" bottom="40" right="166" backgroundAlpha="0">
        <mx:Canvas id="background" styleName="pvpRankBackground" left="25" right="25" top="0" bottom="0">
            <mx:Canvas id="progressBackground" styleName="pvpRankLevelBoxBackground" height="50" left="15" right="15" top="15">
                <mx:Canvas id="overviewProgressContent" left="0" top="0" right="75" bottom="0">
                    <mx:VBox left="0" right="0" bottom="0" top="5" verticalGap="0" horizontalAlign="center">
