        private var _maximum:Number = 10;
        private var _minimum:Number = 0;
        private var _value:Number = 0;

        private function init():void
        {
            this.value = 0;
        }

        private function startSliderDrag(event:MouseEvent):void
        {
            global.getApplication().addEventListener(MouseEvent.MOUSE_UP, this.stopSliderDrag);
            global.getApplication().addEventListener(MouseEvent.MOUSE_MOVE, this.moveSliderOnDrag);
        }

        private function stopSliderDrag(event:MouseEvent):void
        {
            global.getApplication().removeEventListener(MouseEvent.MOUSE_MOVE, this.moveSliderOnDrag);
            global.getApplication().removeEventListener(MouseEvent.MOUSE_UP, this.stopSliderDrag);
        }

        private function moveSliderOnClick():void
        {
            this.moveSliderOnDrag();
        }

        private function moveSliderOnDrag(event:MouseEvent = null):void
        {
            var _local_2:Number = (this.contentMouseX / (this.sliderBar.width - this.handle.width));
            var _local_3:Number = Math.round((this.minimum + (this.maximum * _local_2)));
            _local_3 = Math.max(_local_3, this._minimum);
            this.value = Math.min(_local_3, this.limit);
        }

        private function moveHandle():void
        {
            var _local_1:Number = (this.value / (this.maximum - this.minimum));
            this.handle.x = ((this.sliderBar.width - this.handle.width) * _local_1);
        }

        public function set handleX(value:Number):void
        {
            this.handle.x = (value + this.handle.width);
        }

        public function set slideBarwidth(value:Number):void
        {
            this.sliderBar.scaleX = (value / this.sliderBar.width);
