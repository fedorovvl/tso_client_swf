            handle.addEventListener("mouseDown", onHandle_mouseDown);
            addEventListener("creationComplete", onCreationComplete);
        }

        [Embed(source="../../../../assets/embedded/slider/slider_slider_handle_small.png")]
        private var handleEmbed:Class;

