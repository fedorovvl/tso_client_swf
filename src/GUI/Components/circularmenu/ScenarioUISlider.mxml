        {
            return (_value);
        }

        public function set value(newValue:Number):void
        {
            if (newValue != this._value)
            {
                newValue = Math.min(newValue, this.maximum);
                this._value = newValue;
                dispatchEvent(new SliderEvent(SliderEvent.CHANGE, false, false, -1, newValue));
                this.moveHandle();
            };
        }

        [Bindable("change")]
        public function get minimum():Number
        {
            return (this._minimum);
        }

        public function set minimum(value:Number):void
        {
            dispatchEvent(new SliderEvent(SliderEvent.CHANGE));
        }

        [Bindable("change")]
        public function get maximum():Number
        {
            return (this._maximum);
        }

        public function set maximum(value:Number):void
        {
            this._maximum = value;
            this.value = this.maximum;
            dispatchEvent(new SliderEvent(SliderEvent.CHANGE));
        }

        public function get limit():Number
        {
            return (this._limit);
        }

        public function set limit(value:Number):void
        {
            this._limit = value;
        }

        public function onSliderBar_click(event:MouseEvent):void
        {
            moveSliderOnClick();
        }

        public function onHandle_mouseDown(event:MouseEvent):void
        {
            startSliderDrag(event);
        }

        public function onCreationComplete(event:FlexEvent):void
        {
