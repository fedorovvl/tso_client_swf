    <gui:CustomLabel id="level" y="193" x="10" width="113" textAlign="center" fontWeight="bold" color="0xFFFFFF" />

    <mx:Button id="pvpRankButton" y="215" width="100" height="25" styleName="optionsMenu" left="18" textIndent="20" textAlign="center" fontWeight="bold" color="0xFFFFFF" />

    <gui:TSOImage id="pvpRankImage" y="215" mouseEnabled="false" left="20" />

    <mx:Button id="achievement" y="246" width="100" height="25" styleName="optionsMenu" textIndent="20" left="18" textAlign="center" fontWeight="bold" color="0xFFFFFF" />

    <gui:TSOImage id="achievementImage" y="249" mouseEnabled="false" left="25" />

