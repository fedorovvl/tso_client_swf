<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:gui="GUI.Components.*"
    width="190" verticalScrollPolicy="off" horizontalScrollPolicy="off">
    <mx:Script><![CDATA[
        import mx.core.ClassFactory;
        import mx.controls.Button;
        import GUI.Components.ItemRenderer.AvatarListItemRenderer;
        import GUI.Components.ToolTips.cToolTipUtil;
        import mx.events.ToolTipEvent;
        import GUI.Assets.gAssetManager;
        import GUI.Loca.cLocaManager;
        import Enums.LOCA_GROUP;
        import global;

        [Embed('../../../assets/embedded/avatar/avatar_achievement.png')]
        private var avatarAchievementSkin:Class;
        [Embed('../../../assets/embedded/avatar/avatar_background.png')]
        private var avatarBackgroundSkin:Class;
        [Embed('../../../assets/embedded/avatar/avatar_pvp_progress_background.png')]
        private var avatarPvpProgressSkin:Class;

        private var avatarUpdates:AvatarUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            pvpRankImage.source = gAssetManager.GetResourceIcon("ValorPoint");
            applySkins(btnNewMail, "ButtonIconNewMail", "ButtonIconNewMail", "ButtonIconNewMail", "ButtonIconNewMail");
            pvpProgressImage.source = avatarPvpProgressSkin;
            backgroundImage.source = avatarBackgroundSkin;
            achievementImage.source = avatarAchievementSkin;
            otherPlayers.itemRenderer = new ClassFactory(AvatarListItemRenderer);
            avatarImage.addEventListener("toolTipCreate", onAvatarImage_toolTipCreate);
            xpTooltipMask.addEventListener("toolTipCreate", onXpTooltipMask_toolTipCreate);
            pvpRankButton.addEventListener("toolTipCreate", onPvpRankButton_toolTipCreate);
            btnQuestBook.addEventListener("toolTipCreate", onBtnQuestBook_toolTipCreate);
            avatarUpdates = new AvatarUpdates(updateAvatarState);
        }

        private function applySkins(button:Button, up:String, down:String, over:String, disabled:String):void
        {
            button.setStyle("upSkin", gAssetManager.GetClass(up));
            button.setStyle("downSkin", gAssetManager.GetClass(down));
            button.setStyle("overSkin", gAssetManager.GetClass(over));
            button.setStyle("disabledSkin", gAssetManager.GetClass(disabled));
        }

        private function updateAvatarState(event:Object = null):void
        {
            var packetLost:Boolean = global.ui_bindable ? global.ui_bindable.mPacketLost : false;
            var defenseMode:Boolean = global.ui_bindable ? global.ui_bindable.mIsDefenseMode : false;
            achievement.enabled = (!(defines.ACHIEVEMENT_THROTTLE_MODE_ACTIVE)) && (!(packetLost));
            btnNewMail.enabled = (!(packetLost));
            btnQuestBook.visible = (!(defenseMode));
            btnQuestBook.enabled = ((!(packetLost)) && (!(defenseMode)));
            var questTip:* = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "QuestButton");
            btnQuestBook.toolTip = ((questTip == undefined) ? null : String(questTip));
        }

        public function onAvatarImage_toolTipCreate(event:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_string, event);
        }

        public function onXpTooltipMask_toolTipCreate(event:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(cToolTipUtil.MULTILINE_string, event);
        }

        public function onPvpRankButton_toolTipCreate(event:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(cToolTipUtil.MULTILINE_string, event);
        }

        public function onBtnQuestBook_toolTipCreate(event:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_string, event);
        }
    ]]></mx:Script>

