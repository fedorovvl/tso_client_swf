<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" creationPolicy="all">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import GUI.Components.StandardButton;
        import mx.containers.HBox;
        import GUI.Components.StandardCheckBox;
        import mx.core.mx_internal;
        import mx.styles.CSSStyleDeclaration;
        import GUI.Loca.cLocaManager;
        import Enums.LOCA_GROUP;
        import GUI.Assets.gAssetManager;
        import mx.events.PropertyChangeEvent;
        import flash.events.MouseEvent;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            globalFlash.gui.mMailWindow.mailTypeHeader = this;
            refreshRendererPresentation();
        }

        public function onMailTypeFilterHeaderRenderer_Canvas1_rollOut(argument1:MouseEvent):void
        {
            this.setStyle("backgroundAlpha", 0);
            this.btnArrow.setStyle("upSkin", gAssetManager.GetClass("ArrowSmallSUp"));
        }

        public function onMailTypeFilterHeaderRenderer_Canvas1_rollOver(argument1:MouseEvent):void
        {
            this.setStyle("backgroundAlpha", 0.1);
            this.btnArrow.setStyle("upSkin", gAssetManager.GetClass("ArrowSmallSOver"));
        }

        private function readPresentationValue1():String
        {
            var localValue1:* = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "SelectDeselect");
            return ((localValue1 == undefined) ? null : String(localValue1));
        }

        private function readPresentationValue3():String
        {
            var localValue1:* = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "SelectionFilter");
            return ((localValue1 == undefined) ? null : String(localValue1));
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.setStyle("backgroundColor", 0xFFFFFF);
            this.setStyle("backgroundAlpha", 0);
            btnArrow.setStyle("upSkin", gAssetManager.GetClass("ArrowSmallSUp"));
            this.horizontalScrollPolicy = "off";
            this.verticalScrollPolicy = "off";
            this.creationPolicy = "all";
            this.addEventListener("rollOver", this.onMailTypeFilterHeaderRenderer_Canvas1_rollOver);
            this.addEventListener("rollOut", this.onMailTypeFilterHeaderRenderer_Canvas1_rollOut);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);
                btnSelect.toolTip = readPresentationValue1();
                btnArrow.toolTip = readPresentationValue3();
            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:HBox id="btnHeader" percentWidth="100" creationPolicy="all" horizontalScrollPolicy="off" verticalScrollPolicy="off" verticalAlign="middle" horizontalAlign="center" horizontalGap="-2">
        <ui:StandardCheckBox id="btnSelect" selected="false" />
        <ui:StandardButton id="btnArrow" mouseEnabled="false" label="" width="20" labelPlacement="left" />
    </mx:HBox>
</mx:Canvas>
