<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" width="140" height="29">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import GUI.Components.CustomLabel;
        import GUI.Components.TSOImage;
        import GUI.Components.StandardCheckBox;
        import mx.containers.HBox;
        import mx.controls.Spacer;
        import mx.core.mx_internal;
        import mx.styles.CSSStyleDeclaration;
        import mx.events.PropertyChangeEvent;
        import Tasks.Task;
        import GUI.Assets.gAssetManager;
        import Fulfilments.Identity;
        import GUI.Loca.cLocaManager;
        import Enums.LOCA_GROUP;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        public static const TASK_ITEM_CLICK:String = "taskItemClick";

        private var style:Class;

        public function setSelected(argument1:Boolean):void
        {
            if (argument1)
            {
                if ((data as Task).getFinished())
                {
                    this.style = gAssetManager.GetClass("QuestItemBgWonSelected");
                }
                else
                {
                    this.style = gAssetManager.GetClass("QuestItemBgSelected");
                };
                this.setStyle("backgroundImage", this.style);
            };
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            var localValue2:Task = (argument1 as Task);
            if (((!(argument1 == null)) && (!(localValue2 == null))))
            {
                super.data = argument1;
                this.cb1.enabled = false;
                this.cb1.selected = localValue2.getFinished();
                this.taskId.text = cLocaManager.GetInstance().GetText(LOCA_GROUP.QUEST_LABELS, (argument1 as Identity).getDefinition().getName());
                if (localValue2.getFinished())
                {
                    this.style = gAssetManager.GetClass("QuestItemBgWon");
                }
                else
                {
                    this.style = gAssetManager.GetClass("QuestItemBgNormal");
                };
                this.setStyle("backgroundImage", this.style);
                this.setSelected(localValue2.selected);
            };
            refreshRendererPresentation();
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.setStyle("backgroundAlpha", 1);
            this.setStyle("backgroundSize", "100%");
            this.width = 140;
            this.height = 29;
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);
                configuredTSOImage1.source = gAssetManager.GetResourceIcon("QuestLong");
                if (data != null && data is Identity)
                {
                    cb1.selected = (data as Identity).isTracked;
                }
            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:HBox id="viewHBox1" percentWidth="100" percentHeight="100" backgroundColor="8676928" backgroundAlpha="0" paddingLeft="3" paddingRight="5">
        <ui:TSOImage id="configuredTSOImage1"  top="2" verticalCenter="0" horizontalCenter="0" />
        <ui:CustomLabel id="taskId" maxWidth="104"  paddingTop="4" verticalCenter="0" fontWeight="bold" color="0" />
        <mx:Spacer id="viewSpacer1" percentWidth="100" />
        <ui:StandardCheckBox id="cb1" mouseEnabled="false"  paddingTop="5" verticalCenter="0" />
    </mx:HBox>
</mx:Canvas>
