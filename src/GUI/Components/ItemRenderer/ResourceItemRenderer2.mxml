<?xml version="1.0" encoding="utf-8"?>
<mx:Box xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" height="26">
    <mx:Script><![CDATA[
        import mx.containers.Box;
        import mx.controls.Image;
        import mx.controls.Label;
        import ServerState.dResource;
        import mx.core.mx_internal;
        import mx.styles.CSSStyleDeclaration;
        import GUI.Components.ToolTips.cToolTipUtil;
        import mx.events.ToolTipEvent;
        import Communication.VO.dPickupItemVO;
        import GUI.Loca.cLocaManager;
        import Enums.LOCA_GROUP;
        import GUI.Assets.gAssetManager;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        [Bindable]
        private var _size:int = 12;

        [Bindable]
        private var _color:uint;

        [Bindable]
        private var _resource:dResource;

        public function set size(argument1:int):void
        {
            this._size = argument1;
        }

        public function set color(argument1:uint):void
        {
            this._color = argument1;
        }

        public function get resource():dResource
        {
            return (this._resource);
        }

        public function onResourceItemRenderer2_Box1_toolTipCreate(argument1:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_string, argument1);
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            var localValue2:dResource = new dResource();
            if ((data is dPickupItemVO))
            {
                localValue2.name_string = (data as dPickupItemVO).item_string;
                localValue2.amount = (data as dPickupItemVO).amount;
            }
            else
            {
                if (data != null)
                {
                    localValue2.name_string = data["name_string"];
                    localValue2.amount = int(data["amount"]);
                };
            };
            this.resource = localValue2;
            refreshRendererPresentation();
        }

        public function set resource(argument1:dResource):void
        {
            this._resource = argument1;
            toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.RESOURCES, this._resource.name_string);
        }

        private function readPresentationValue4():String
        {
            var localValue1:* = _resource.amount;
            return ((localValue1 == undefined) ? null : String(localValue1));
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.setStyle("paddingLeft", 0);
            this.setStyle("paddingTop", 0);
            this.setStyle("paddingBottom", 0);
            this.setStyle("horizontalGap", 0);
            this.setStyle("verticalGap", 0);
            this.setStyle("verticalAlign", "middle");
            this.setStyle("horizontalAlign", "center");
            this.horizontalScrollPolicy = "off";
            this.verticalScrollPolicy = "off";
            this.height = 26;
            this.direction = "horizontal";
            this.addEventListener("toolTipCreate", this.onResourceItemRenderer2_Box1_toolTipCreate);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"],
                [_resource, "propertyChange"]]);
                if (_resource != null)
                {
                    resourceIcon.source = gAssetManager.GetResourceIcon(_resource.name_string);
                }
                amountLabel.setStyle("fontSize", _size);
                amountLabel.setStyle("color", _color);
                if (_resource != null)
                {
                    amountLabel.text = readPresentationValue4();
                }
            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:Image id="resourceIcon" width="26" height="25" />
    <mx:Label id="amountLabel"  fontWeight="bold" />
</mx:Box>
