<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" width="50" height="12">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import mx.core.mx_internal;
        import mx.events.PropertyChangeEvent;
        import Enums.GUI_END;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        private const STATE_DISABLED:String = "disabled";

        private const STATE_ENABLED:String = "enabled";

        private var centerClassName:String;

        private var rightClassName:String;

        private var leftClassName:String;

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            var localValue2:int;
            if (data.enabled)
            {
                switch (data.end)
                {
                    case GUI_END.LEFT:
                    this.barCanvas.setStyle("styleName", "tierBarLeft");
                    this.barProgress.setStyle("styleName", "tierBarProgressLeft");
                    localValue2 = 1;
                    break;
                    case GUI_END.RIGHT:
                    this.barCanvas.setStyle("styleName", "tierBarRight");
                    this.barProgress.setStyle("styleName", "tierBarProgressRight");
                    this.barProgress.setStyle("left", 4);
                    break;
                    default:
                    this.barCanvas.setStyle("styleName", "tierBar");
                    this.barProgress.setStyle("styleName", "tierBarProgress");
                    this.barProgress.setStyle("left", 4);
                };
            }
            else
            {
                switch (data.end)
                {
                    case GUI_END.LEFT:
                    this.barCanvas.setStyle("styleName", "tierBarLeftDisabled");
                    break;
                    case GUI_END.RIGHT:
                    this.barCanvas.setStyle("styleName", "tierBarRightDisabled");
                    break;
                    default:
                    this.barCanvas.setStyle("styleName", "tierBarDisabled");
                };
            };
            if (data.value > data.max)
            {
                this.barProgress.width = ((this.barCanvas.width - 8) + localValue2);
            }
            else
            {
                this.barProgress.width = (((data.value - data.min) / (data.max - data.min)) * this.barCanvas.width);
            };
            refreshRendererPresentation();
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.width = 50;
            this.height = 12;
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:Canvas id="barCanvas" height="12" left="0" right="0" top="0">
        <mx:Canvas id="barProgress" height="4" width="20"  left="3" top="3" />
    </mx:Canvas>
</mx:Canvas>
