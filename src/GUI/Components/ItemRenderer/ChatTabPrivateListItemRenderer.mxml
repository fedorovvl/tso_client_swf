<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import GUI.Components.CustomLabel;
        import mx.controls.Button;
        import mx.core.mx_internal;
        import mx.styles.CSSStyleDeclaration;
        import flash.events.MouseEvent;
        import com.bluebyte.bluefire.api.model.vo.ChannelVO;
        import mx.controls.TileList;
        import mx.events.ListEvent;
        import flash.events.Event;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.IEventDispatcher;

        public static const PRIVATE_LIST_REMOVE:String = "privateListRemove";

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            if ((argument1 is ChannelVO))
            {
                if (TileList(owner).selectedItem == data)
                {
                    this.styleName = "chatPrivateListSelected";
                }
                else
                {
                    if (ChannelVO(data).newMessages)
                    {
                        this.styleName = "chatPrivateListNewMessage";
                    }
                    else
                    {
                        this.styleName = "chatPrivateList";
                    };
                };
            };
            refreshRendererPresentation();
        }

        private function HandleRemoveClick(argument1:Event):void
        {
            this.dispatchEvent(new ListEvent(PRIVATE_LIST_REMOVE, true, false, 0, TileList(owner).dataProvider.getItemIndex(data)));
            argument1.stopImmediatePropagation();
            argument1.preventDefault();
        }

        private function readPresentationValue1():String
        {
            var localValue1:* = (data as ChannelVO).name;
            return ((localValue1 == undefined) ? null : String(localValue1));
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.setStyle("verticalCenter", 0);
            this.setStyle("backgroundAlpha", 1);
            this.setStyle("backgroundSize", "100%");
            viewButton1.addEventListener("click", HandleRemoveClick);
            this.percentWidth = 25;
            this.percentHeight = 50;
            this.minWidth = 75;
            this.maxWidth = 75;
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);
                if (data != null && data is ChannelVO)
                {
                    configuredCustomLabel1.text = readPresentationValue1();
                }
            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <ui:CustomLabel id="configuredCustomLabel1" percentHeight="100" minWidth="60" maxWidth="60"  left="0" />
    <mx:Button id="viewButton1" styleName="closeSmall" width="13" height="12"  right="3" bottom="6" />
</mx:Canvas>
