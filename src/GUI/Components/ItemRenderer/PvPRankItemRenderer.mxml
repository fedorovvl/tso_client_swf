        protected function mouseOutHandler(argument1:MouseEvent):void
        {
            switch (currentState)
            {
                case STATE_BUTTON_MOUSEOVER:
                this.frameBackground.setStyle("backgroundImage", gAssetManager.GetClass("PvPRankItemRendererBGButtonNormal"));
                currentState = STATE_BUTTON_NORMAL;
                return;
            };
        }

        public function onAnimEnd():void
        {
            this.animation.parent.removeChild(this.animation);
            currentState = STATE_NORMAL;
            globalFlash.gui.mPvPLeveLRewardsPanel.SetData((data as dPvPRankItemRendererData).rank);
            globalFlash.gui.mPvPLeveLRewardsPanel.ShowSecondaryPanel();
        }

        private function CreateTooltip(argument1:ToolTipEvent):void
        {
            if ((data as dPvPRankItemRendererData).rank > 1)
            {
                cToolTipUtil.createToolTip(cToolTipUtil.PVP_LEVEL_REWARDS_TOOLTIP_string, argument1, (data as dPvPRankItemRendererData));
            }
            else
            {
                cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_string, argument1);
            };
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            var localValue2:dPvPRankItemRendererData;
            if ((argument1 is dPvPRankItemRendererData))
            {
                super.data = argument1;
                localValue2 = (argument1 as dPvPRankItemRendererData);
            }
            else
            {
                throw (new Error("Unexpected data passed to PvP Rank Itemrenderer"));
            };
            this.levelLabel.text = cLocaManager.GetInstance().getLabel("Level", [localValue2.rank.toString()]);
            currentState = localValue2.state;
            if (this.animation == null)
            {
                this.animation = new Animation();
                this.animation.xml = cXML.getFirstChildBasedOnAttribute(global.textureAtlas, "imagePath", "summerevent_sparkle.png");
                this.animation.x = (this.frame.x + 13);
                this.animation.y = this.frame.y;
            };
            if (localValue2.rank > 1)
            {
                this.rollOverCanvas.toolTip = localValue2.toolTip;
            }
            else
            {
                this.rollOverCanvas.toolTip = cLocaManager.GetInstance().getLabel("PvPLevel", [(data as dPvPRankItemRendererData).rank]);
            };
            switch (localValue2.iconName)
            {
                case "ValorRateBonus":
                case "buff_fill_deposit_iron":
                case "Expedition_weaponsmith":
                case "ColonyYieldBonus":
                this.resourceIcon.setStyle("top", 18);
                break;
                default:
                this.resourceIcon.setStyle("top", 12);
            };
            this.resourceIcon.source = gAssetManager.GetBuffIcon(localValue2.iconName);
            refreshRendererPresentation();
        }

        protected function mouseClickHandler(argument1:MouseEvent):void
        {
            if (((currentState == STATE_BUTTON_NORMAL) || (currentState == STATE_BUTTON_MOUSEOVER)))
            {
                this.frameBackground.setStyle("backgroundImage", gAssetManager.GetClass("PvPRankItemRendererBGButtonPressed"));
                this.animation.onAnimationEnd = this.onAnimEnd;
                addChild(this.animation);
                this.animation.play();
                currentState = STATE_BUTTON_PRESSED;
                dispatchEvent(new Event(CLAIM_EVENT, true, true));
            };
        }

        protected function mouseOverHandler(argument1:MouseEvent):void
        {
            switch (currentState)
            {
                case STATE_BUTTON_NORMAL:
                this.frameBackground.setStyle("backgroundImage", gAssetManager.GetClass("PvPRankItemRendererBGButtonMouseOver"));
                currentState = STATE_BUTTON_MOUSEOVER;
                return;
            };
        }

        protected function creationCompleteHandler(argument1:FlexEvent):void
        {
            this.rollOverCanvas.addEventListener(MouseEvent.MOUSE_OVER, this.mouseOverHandler);
            this.rollOverCanvas.addEventListener(MouseEvent.MOUSE_OUT, this.mouseOutHandler);
            this.rollOverCanvas.addEventListener(MouseEvent.CLICK, this.mouseClickHandler);
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            frameBackground.setStyle("backgroundImage", _embed_mxml_____data_src_gfx_embedded_pvpprogressionwindow_button_std_png_336864021);
            frame.setStyle("backgroundImage", _embed_mxml_____data_src_gfx_embedded_pvpprogressionwindow_frame_png_1642481333);
            tickImage.source = _embed_mxml_____data_src_gfx_embedded_pvpprogressionwindow_checkmark_png_96251755;
            rollOverCanvas.addEventListener("toolTipCreate", CreateTooltip);
            frameBackgroundBackgroundImageOverride1.value = gAssetManager.GetClass("PvPRankItemRendererBGNormal");
            frameBackgroundBackgroundImageOverride2.value = gAssetManager.GetClass("PvPRankItemRendererBGDisabled");
            this.width = 71;
            this.height = 92;
            this.horizontalScrollPolicy = "off";
            this.verticalScrollPolicy = "off";

            this.addEventListener("creationComplete", this.creationCompleteHandler);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);
                frameBackgroundBackgroundImageOverride1.target = frameBackground;
                tickImageVisibleOverride1.target = tickImage;
                frameBackgroundBackgroundImageOverride2.target = frameBackground;
                tickImageVisibleOverride2.target = tickImage;
                tickImageVisibleOverride3.target = tickImage;
                tickImageVisibleOverride4.target = tickImage;
                tickImageVisibleOverride5.target = tickImage;
            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

