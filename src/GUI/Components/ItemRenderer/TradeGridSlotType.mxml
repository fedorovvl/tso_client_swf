<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" implements="mx.controls.listClasses.IDropInListItemRenderer">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import mx.controls.listClasses.IDropInListItemRenderer;
        import GUI.Components.CustomLabel;
        import mx.controls.listClasses.BaseListData;
        import mx.core.mx_internal;
        import mx.events.PropertyChangeEvent;
        import mx.controls.dataGridClasses.DataGridListData;
        import Enums.TRADE_SLOT_TYPE;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        private var _listData:BaseListData;

        private var _object:Object;

        public function get listData():BaseListData
        {
            return (this._listData);
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            var localValue2:Object;
            super.data = (this._object = argument1);
            if (argument1[DataGridListData(this.listData).dataField] == TRADE_SLOT_TYPE.FREE_SLOT)
            {
                this.typeString.text = argument1.slotValue;
                this.typeString.visible = true;
                this.resourceRenderer.visible = false;
            }
            else
            {
                localValue2 = new Object();
                if (argument1[DataGridListData(this.listData).dataField] == TRADE_SLOT_TYPE.PAID_SLOT_WITH_GEMS)
                {
                    localValue2.name_string = defines.HARD_CURRENCY_RESOURCE_NAME_string;
                }
                else
                {
                    localValue2.name_string = defines.COIN_RESOURCE_NAME_string;
                };
                localValue2.amount = Number(argument1.slotValue);
                this.resourceRenderer.data = localValue2;
                this.resourceRenderer.visible = true;
                this.typeString.visible = false;
            };
            refreshRendererPresentation();
        }

        public function set listData(argument1:BaseListData):void
        {
            this._listData = argument1;
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.clipContent = false;
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <local:ResourceItemRenderer id="resourceRenderer" x="5" color="0xFFFFFF" enableAmountCheck="false" />
    <ui:CustomLabel id="typeString"  horizontalCenter="0" />
</mx:Canvas>
