                            };
                        }
                        else
                        {
                            cToolTipUtil.createToolTip(cToolTipUtil.BUFF_string, argument1, this.getProductionData());
                        };
                    };
                };
            }
            else
            {
                cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_ERROR_string, argument1, true);
            };
        }

        override protected function commitProperties():void
        {
            var localValue1:dSelectableDataObject;
            var localValue2:dRequirementsVO;
            super.commitProperties();
            if (this._dataChanged)
            {
                this._dataChanged = false;
                if (!(styleName is String))
                {
                    styleName = "backgroundNormal";
                };
                styleName = ((data.selected) ? "backgroundHighlight" : "backgroundNormal");
                localValue1 = (data as dSelectableDataObject);
                if (localValue1 == null)
                {
                    return;
                };
                localValue2 = global.ui.mRequirements.timedProductionRequirements_vector[this.getProductionData().GetType()];
                this.itemEnabled = localValue2.isFulfilledForSkillList(global.ui.mCurrentPlayer.getSkills());
                this.unitIcon.source = gAssetManager.GetResourceIcon(this.getProductionData().GetType(), this.itemEnabled);
                id = this.getProductionData().GetType();
                if (this.itemEnabled)
                {
                    toolTip = this.getProductionData().GetType();
                }
                else
                {
                    toolTip = localValue2.locaString;
                };
                this.skillBonus = this.GetBonusPercentage();
                this.StarIcon.visible = (this.skillBonus > 0);
                this.StarIcon.toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "TimedInfoPanelOrderBonus", [this.skillBonus]);
                this.areaBuffDefinition = this.getAreaBuffDefinitionToApply((localValue1.data as EffectTimedProductionDefinition));
                this.tmpBuff = null;
            };
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            this._dataChanged = true;
            invalidateProperties();
            refreshRendererPresentation();
        }

        private function getProductionData():Object
        {
            return ((data != null) ? data.data : null);
        }

        private function readPresentationValue2():String
        {
            var localValue1:* = amountInProduction;
            return ((localValue1 == undefined) ? null : String(localValue1));
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.setStyle("backgroundAlpha", 1);
            this.setStyle("backgroundSize", "100%");
            StarIcon.source = gAssetManager.GetBitmap("SmallIconStar");
            this.width = 45;
            this.height = 43;
            this.addEventListener("rollOver", this.canvas1_rollOverHandler);
            this.addEventListener("rollOut", this.canvas1_rollOutHandler);
            this.addEventListener("toolTipCreate", this.CreateTooltip);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);
                configuredLabel1.text = readPresentationValue2();
                configuredLabel1.visible = !(amountInProduction == 0);
            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:Image id="unitIcon"  horizontalCenter="0" verticalCenter="0" />
    <mx:Image id="StarIcon"  right="2" />
