        private function CreateTooltip(argument1:ToolTipEvent):void
        {
            var localValue2:EffectTimedProductionDefinition;
            if (this.itemEnabled)
            {
                if ((this.getProductionData() is cMilitaryUnitDescription))
                {
                    cToolTipUtil.createToolTip(cToolTipUtil.MILITARY_UNIT_string, argument1);
                }
                else
                {
                    if ((this.getProductionData() is cMilitaryUnitData))
                    {
                        cToolTipUtil.createToolTip(cToolTipUtil.MILITARY_UNIT_VERBOSE_string, argument1, this.skillBonus);
                    }
                    else
                    {
                        if ((this.getProductionData() is EffectTimedProductionDefinition))
                        {
