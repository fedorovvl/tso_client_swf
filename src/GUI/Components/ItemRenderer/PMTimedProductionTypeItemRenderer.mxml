        private function getAreaBuffDefinitionToApply(argument1:EffectTimedProductionDefinition):cBuffDefinition
        {
            var localValue2:EffectVO;
            if (argument1)
            {
                for each (localValue2 in argument1.effects_vector)
                {
                    if (((localValue2.effect_string == ApplyBuff.XML_string) && (cBuff.getIsAreaBuff(localValue2.name_string))))
                    {
                        return (cBuff.getBuffDefinitionByName(localValue2.name_string));
                    };
                };
            };
            return (null);
