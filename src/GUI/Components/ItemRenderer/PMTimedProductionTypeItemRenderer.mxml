            var localValue1:dTimedProductionVO = new dTimedProductionVO();
            localValue1.type_string = id;
            if ((this.getProductionData() is cMilitaryUnitDescription))
            {
                localValue1.productionType = (((this.getProductionData() as cMilitaryUnitDescription).GetIsElite()) ? TIMED_PRODUCTION_TYPE.ELITE_UNITS : TIMED_PRODUCTION_TYPE.MILITARY_UNIT);
                localValue2 = new cMilitaryUnitProductionOrder(localValue1, (global.ui as cGameInterface));
                return (localValue2.GetProductionMultiplierInPercentage());
            };
            if ((this.getProductionData() is cMilitaryUnitData))
            {
                localValue1.productionType = TIMED_PRODUCTION_TYPE.COMBAT_THREE_UNITS;
                localValue3 = new cMilitaryUnitProductionOrder(localValue1, (global.ui as cGameInterface));
