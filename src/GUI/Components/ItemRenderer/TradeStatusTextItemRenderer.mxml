<?xml version="1.0" encoding="utf-8"?>
<ui:CustomLabel xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*">
    <mx:Script><![CDATA[
        import GUI.Components.CustomLabel;
        import GUI.Components.ToolTips.cToolTipUtil;
        import mx.events.ToolTipEvent;
        import mx.controls.dataGridClasses.DataGridListData;
        import Enums.TRADE_STATUS;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        public function onTradeStatusTextItemRenderer_CustomLabel1_toolTipCreate(argument1:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_string, argument1);
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            this.text = "";
            super.data = argument1;
            if (DataGridListData(listData).dataField == "remainingLots")
            {
                if (argument1.remainingLots == -1)
                {
                    this.text = "";
                }
                else
                {
                    this.text = ((argument1.remainingLots == 0) ? ("x" + 1) : ("x" + argument1.remainingLots));
                    this.setStyle("fontWeight", "bold");
                    this.setStyle("color", 15461004);
                    this.setStyle("fontSize", 13);
                };
            }
            else
            {
                if (DataGridListData(listData).dataField == "remainingTime")
                {
                    this.text = argument1.runningTime;
                    this.setStyle("fontWeight", "normal");
                    this.setStyle("fontSize", 12);
                    if (argument1.status == TRADE_STATUS.TRADE_TIMER_STATE)
                    {
                        this.setStyle("color", 0xFFFFFF);
                    }
                    else
                    {
                        if (argument1.status == TRADE_STATUS.TRADE_EXPIRED)
                        {
                            this.setStyle("color", 0xFF0000);
                        }
                        else
                        {
                            if (argument1.status == TRADE_STATUS.TRADE_EXPIRED_SOLDTO)
                            {
                                this.setStyle("color", 0xFF00);
                            }
                            else
                            {
                                if (argument1.status == TRADE_STATUS.TRADE_EXPIRED_SOME_SOLD)
                                {
                                    this.setStyle("color", 0xFFFFFF);
                                }
                                else
                                {
                                    if (argument1.status == TRADE_STATUS.TRADE_EXPIRED_ALL_SOLD)
                                    {
                                        this.setStyle("color", 0xFF00);
                                    };
                                };
                            };
                        };
                    };
                };
            };
            refreshRendererPresentation();
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();

            this.height = 22;
            this.addEventListener("toolTipCreate", this.onTradeStatusTextItemRenderer_CustomLabel1_toolTipCreate);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>


</ui:CustomLabel>
