<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" width="230" height="29">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import GUI.Components.SpecialButton;
        import mx.core.mx_internal;
        import mx.events.FlexEvent;
        import Communication.VO.dHelpDefinitionVO;
        import GUI.Loca.cLocaManager;
        import Enums.LOCA_GROUP;
        import GUI.Assets.gAssetManager;
        import flash.events.Event;
        import mx.events.ItemClickEvent;
        import flash.events.MouseEvent;
        import mx.events.PropertyChangeEvent;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.IEventDispatcher;

        public function display(argument1:Event=null):void
        {
            removeEventListener(FlexEvent.CREATION_COMPLETE, this.display);
            var localValue2:dHelpDefinitionVO = (data as dHelpDefinitionVO);
            this.btnItem.labelText = cLocaManager.GetInstance().GetText(LOCA_GROUP.HELP_ITEM_LABEL, localValue2.helpName_string);
            this.btnItem.iconImage = gAssetManager.GetResourceIcon(localValue2.icon_string);
        }

        private function questClickHandler(argument1:MouseEvent):void
        {
            var localValue2:ItemClickEvent = new ItemClickEvent(ItemClickEvent.ITEM_CLICK, true);
            localValue2.item = data;
            dispatchEvent(localValue2);
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            if (this.btnItem)
            {
                this.display();
            }
            else
            {
                addEventListener(FlexEvent.CREATION_COMPLETE, this.display);
            };
            refreshRendererPresentation();
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            btnItem.addEventListener("click", questClickHandler);
            this.horizontalScrollPolicy = "off";
            this.verticalScrollPolicy = "off";
            this.width = 230;
            this.height = 29;
            this.clipContent = false;
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <ui:SpecialButton id="btnItem" normalStyle="QuestItemBgNormal" hoverStyle="QuestItemBgNormal" selectedStyle="QuestItemBgSelected" showShadow="true" height="29" labelLeft="38" iconLeft="4" iconCenter="1"  left="0" right="0" />
</mx:Canvas>
