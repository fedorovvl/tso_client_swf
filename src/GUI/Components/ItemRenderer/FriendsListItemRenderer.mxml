<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" width="71" height="88">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import GUI.Components.CustomLabel;
        import mx.controls.Image;
        import GUI.Components.TSOImage;
        import mx.core.mx_internal;
        import mx.events.PropertyChangeEvent;
        import Communication.VO.dPlayerListItemVO;
        import flash.events.MouseEvent;
        import GUI.Components.ToolTips.cToolTipUtil;
        import mx.events.ToolTipEvent;
        import GUI.Assets.gAssetManager;
        import Enums.AVATAR_SIZE;
        import Interface.cGeneralInterface;
        import GUI.Loca.cLocaManager;
        import Enums.LOCA_GROUP;
        import consts.GameConstants;
        import mx.events.FlexEvent;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        private var mBackground:Class;

        public function ShowContextMenu(argument1:MouseEvent):void
        {
            var localValue2:dPlayerListItemVO = (data as dPlayerListItemVO);
            if (globalFlash.gui.mMailWindow.IsVisible())
            {
                if (localValue2.username != globalFlash.gui.mAvatar.GetDisplayedPlayerVO().username)
                {
                    globalFlash.gui.mMailWindow.editMailPreselected(localValue2);
                    globalFlash.gui.mMailWindow.Show();
                };
                return;
            };
            globalFlash.gui.ShowFriendListMenu(argument1, localValue2);
        }

        public function onPlayerName_toolTipCreate(argument1:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_string, argument1);
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            if (!(styleName is String))
            {
                styleName = "friendBackground";
                if (data.avatarId <= 0)
                {
                    data.avatarId = 0;
                };
                this.avatar.source = gAssetManager.GetAvatarUrl(data.avatarId, AVATAR_SIZE.SMALL);
                this.typeIndicator.source = ((globalFlash.gui.mFriendsList.IsGuildMember((data as dPlayerListItemVO))) ? gAssetManager.GetBitmap("FriendIndicatorGuild") : null);
                this.playerLevel.text = ((data.playerLevel == 0) ? "1" : data.playerLevel);
                this.playerLevel.toolTip = "";
            };
            this.avatar.source = gAssetManager.GetAvatarUrl(data.avatarId, AVATAR_SIZE.SMALL);
            this.typeIndicator.source = ((globalFlash.gui.mFriendsList.IsGuildMember((data as dPlayerListItemVO))) ? gAssetManager.GetBitmap("FriendIndicatorGuild") : null);
            this.playerLevel.text = ((data.playerLevel == 0) ? "1" : data.playerLevel);
            if (data.id > 0)
            {
                if (cGeneralInterface.isDefaultPlayerName(data.username))
                {
                    data.username = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, GameConstants.LABEL_AVATAR_NAME);
                };
                this.playerName.text = data.username;
            }
            else
            {
                if ((data as dPlayerListItemVO).adventureVO != null)
                {
                    this.playerName.text = cLocaManager.GetInstance().GetText(LOCA_GROUP.ADVENTURE_NAME, (data as dPlayerListItemVO).adventureVO.adventureName);
                }
                else
                {
                    this.playerName.text = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "MailSenderAnonymous");
                };
            };
            this.onlineStatus.visible = data.onlineStatus;
            this.currentZoneMarker.visible = (data.id == global.ui.mCurrentViewedZoneID);
            if (data.id == global.ui.mCurrentPlayer.GetPlayerId())
            {
                this.playerName.setStyle("color", 0xFFFFFF);
            }
            else
            {
                this.playerName.setStyle("color", 0x322000);
            };
            refreshRendererPresentation();
        }

        protected function canvas1_updateCompleteHandler(argument1:FlexEvent):void
        {
            if (!(styleName is String))
            {
                styleName = "friendBackground";
            };
        }

        public function onFriendsListItemRenderer_Canvas1_rollOver(argument1:MouseEvent):void
        {
            this.styleName = "friendBackgroundHighlight";
        }

        public function onFriendsListItemRenderer_Canvas1_rollOut(argument1:MouseEvent):void
        {
            this.styleName = "friendBackground";
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            playerName.addEventListener("toolTipCreate", onPlayerName_toolTipCreate);
            currentZoneMarker.source = gAssetManager.GetBitmap("FriendVisit");
            onlineStatus.source = gAssetManager.GetBitmap("OnlineStatusGreen");
            this.horizontalScrollPolicy = "off";
            this.verticalScrollPolicy = "off";
            this.styleName = "friendBackground";
            this.width = 71;
            this.height = 88;
            this.addEventListener("rollOver", this.onFriendsListItemRenderer_Canvas1_rollOver);
            this.addEventListener("rollOut", this.onFriendsListItemRenderer_Canvas1_rollOut);
            this.addEventListener("click", this.ShowContextMenu);
            this.addEventListener("updateComplete", this.canvas1_updateCompleteHandler);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:Image id="typeIndicator" width="71" height="20"  bottom="0" />
    <mx:Image id="currentZoneMarker" visible="false"  top="4" left="4" />
    <ui:TSOImage id="avatar"  top="-1" horizontalCenter="0" />
    <mx:Image id="onlineStatus"  left="5" top="5" />
    <ui:CustomLabel id="playerName" width="67"  horizontalCenter="0" top="49" fontWeight="bold" textAlign="center" />
    <ui:CustomLabel id="playerLevel" width="67"  horizontalCenter="0" top="66" color="0xFFFFFF" fontWeight="bold" textAlign="center" />
</mx:Canvas>
