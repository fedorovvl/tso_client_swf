        <ui:CustomLabel id="lblTimeLeft" mouseEnabled="false" color="0xFFFFFF" left="74" top="22" fontWeight="bold" />
        <local:ResourceIconRenderer id="incomeResourceRendererBottom" bottom="-3" left="56" />
        <mx:HBox id="viewHBox1" bottom="2" left="86" horizontalGap="-4">
