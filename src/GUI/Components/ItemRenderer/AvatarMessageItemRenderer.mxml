<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" xmlns:ns3="GUI.Components.achievement.detail.*" width="250">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import GUI.Components.CustomLabel;
        import mx.effects.Fade;
        import mx.controls.Image;
        import GUI.achievement.view.detail.AchievementIconView;
        import GUI.Components.CustomText;
        import GUI.Components.achievement.detail.AchievementIconViewComponent;
        import mx.core.mx_internal;
        import mx.styles.CSSStyleDeclaration;
        import flash.events.Event;
        import flash.events.MouseEvent;
        import mx.events.FlexEvent;
        import GUI.Assets.gAssetManager;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.IEventDispatcher;

        public static const AvatarMessageBackgroundNormal:String = "AvatarMessageRed";

        public static const AvatarMessageBackgroundNormalHighlight:String = "AvatarMessageRedHighlight";

        public static const AvatarMessageBackgroundAchievement:String = "AvatarMessageAchievement";

        public static const AvatarMessageBackgroundAchievementHighlight:String = "AvatarMessageAchievementHighlight";

        public var AvatarMessageBackground:String = "AvatarMessageRed";

        private var displayDurationTicks:Number = 10000;

        [Bindable]
        public var fadeOut:Fade;

        private var hidden:Boolean = false;

        private var mData:Object;

        public var iconView:AchievementIconView;

        public var AvatarMessageBackgroundHighlight:String = "AvatarMessageRedHighlight";

        private var hideTick:Number;

        private function SetHideTime():void
        {
            this.hideTick = (global.ui.mCalculateTicks.GetLastTick() + this.displayDurationTicks);
            this.addEventListener(Event.ENTER_FRAME, this.CheckDisplay);
        }

        private function removeFromParent():void
        {
            this.parent.removeChild(this);
            if (this.iconView != null)
            {
                this.iconView.dispose();
            };
        }

        public function setDisplayDurationTicks(argument1:Number=10000):void
        {
            this.displayDurationTicks = argument1;
        }

        public function onAvatarMessageItemRenderer_Canvas1_addedToStage(argument1:Event):void
        {
            this.SetHideTime();
        }

        public function getData():Object
        {
            return (this.mData);
        }

        public function onAvatarMessageItemRenderer_Canvas1_rollOut(argument1:MouseEvent):void
        {
            this.setOnRollOut();
        }

        public function onAvatarMessageItemRenderer_Canvas1_creationComplete(argument1:FlexEvent):void
        {
            this.setOnCreationComplete();
        }

        public function setOnCreationComplete():void
        {
            this.setOnRollOut();
        }

        public function setData(argument1:Object):void
        {
            this.mData = argument1;
        }

        private function CheckDisplay(argument1:Event):void
        {
            if (((!(this.hidden)) && (global.ui.mCalculateTicks.GetLastTick() >= this.hideTick)))
            {
                this.fadeOut.play();
                this.hidden = true;
            }
            else
            {
                if (global.ui.mCalculateTicks.GetLastTick() >= (this.hideTick + 1250))
                {
                    this.removeEventListener(Event.ENTER_FRAME, this.CheckDisplay);
                    this.removeFromParent();
                };
            };
        }

        public function forceHide():void
        {
            this.removeEventListener(Event.ENTER_FRAME, this.CheckDisplay);
            this.removeFromParent();
        }

        private function createFade1():Fade
        {
            var localValue1:Fade = new Fade();
            this.fadeOut = localValue1;
            localValue1.alphaFrom = 1;
            localValue1.alphaTo = 0;
            localValue1.duration = 1000;
            return (localValue1);
        }

        public function setOnRollOut():void
        {
            this.setStyle("backgroundImage", gAssetManager.GetClass(this.AvatarMessageBackground));
        }

        public function onAvatarMessageItemRenderer_Canvas1_rollOver(argument1:MouseEvent):void
        {
            this.setOnRollOver();
        }

        public function setOnRollOver():void
        {
            this.setStyle("backgroundImage", gAssetManager.GetClass(this.AvatarMessageBackgroundHighlight));
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.setStyle("backgroundSize", "100%");
            this.width = 250;
            this.minHeight = 82;
            this.createFade1();
            this.addEventListener("creationComplete", this.onAvatarMessageItemRenderer_Canvas1_creationComplete);
            this.addEventListener("rollOver", this.onAvatarMessageItemRenderer_Canvas1_rollOver);
            this.addEventListener("rollOut", this.onAvatarMessageItemRenderer_Canvas1_rollOut);
            this.addEventListener("addedToStage", this.onAvatarMessageItemRenderer_Canvas1_addedToStage);
            if (this.stage != null)
            {
                this.SetHideTime();
            };
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"],
                [headlineLabel, "widthChanged"]]);
                fadeOut.target = this;
                messageBody.width = headlineLabel.width;
            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <ui:CustomLabel id="headlineLabel" width="177"  color="0xFFFFFF" fontWeight="bold" left="61" top="8" />
    <mx:Image id="image" scaleContent="false"  left="0" right="185" top="5" bottom="5" horizontalAlign="center" verticalAlign="middle" />
    <ns3:AchievementIconViewComponent id="iconBox" visible="false"  left="5" top="5" />
    <ui:CustomText id="messageBody" selectable="false"  left="63" right="14" top="26" bottom="5" color="0xFFFFFF" />
</mx:Canvas>
