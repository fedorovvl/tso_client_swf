            };
        }

        private function init(argument1:FlexEvent):void
        {
            this.removeEventListener(FlexEvent.CREATION_COMPLETE, this.init);
            this.addEventListener(MouseEvent.CLICK, this.handleClick, false, 0, true);
            this.inputList.removeAllChildren();
            if (this.chain)
            {
                this.initActiveChain();
                if ((((!(this.building == null)) && (!(this.chain == null))) && (this.chain.getChainIsEquivalentToBuilding(this.building))))
                {
                    this.initSelectedActiveChain();
                };
                if (!this.chain.getIsUnlocked(this.generalInterface))
                {
                    this.enabled = false;
                    this.setStyle(this.BACKGROUND_COLOR_STYLE_NAME, this.DISABLED_COLOUR);
                    this.toolTip = this.chain.getToolTipText(this.generalInterface);
                }
                else
                {
                    this.enabled = true;
                };
            }
            else
            {
                this.initDestroyChain();
                this.enabled = true;
            };
        }

