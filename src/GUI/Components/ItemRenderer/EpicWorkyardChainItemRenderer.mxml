        public function setData(argument1:ChainVO, argument2:cGeneralInterface, argument3:EpicWorkyardSubBuilding):void
        {
            this.chain = argument1;
            this.generalInterface = argument2;
            this.building = argument3;
            if (((this.inputList) && (this.outputResourceIcon)))
            {
                this.init(null);
            }
            else
            {
                this.addEventListener(FlexEvent.CREATION_COMPLETE, this.init, false, 0, true);
            };
