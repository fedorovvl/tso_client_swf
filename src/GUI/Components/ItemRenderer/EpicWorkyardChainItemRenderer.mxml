            var localValue1:cResources = this.generalInterface.mCurrentPlayerZone.GetResources(this.generalInterface.mCurrentPlayer);
            var localValue2:dResourceCreationDefinition = gEconomics.GetResourcesCreationDefinitionForBuilding(this.chain.getName());
            var localValue5:dResource = new dResource();
            this.chain.computeInputOutput();
            if (localValue2)
            {
                if (localValue2.amountRemoved >= 0)
                {
                    if (localValue2.externalResource_string == "")
                    {
                        for each (localValue6 in localValue2.necessaryResources_vector)
                        {
                            localValue3 = new EpicWorkyardResourceItemRenderer();
                            localValue5 = new dResource();
                            localValue5.name_string = localValue6.name_string;
                            localValue5.amount = (localValue6.amount * this.chain.getProductivityInput());
                            localValue3.data = localValue5;
                            this.inputList.addChild(localValue3);
                        };
                    }
                    else
                    {
                        localValue4 = new ResourceIconRenderer();
                        localValue4.missing = (((this.building) && (this.building.IsBuildingInfoIconDelayPassed())) && (this.building.GetResourceCreation().GetProductionState() == cResourceCreation.PRODUCTIONSTATE_ERROR_NECESSARY_RESOURCE_MISSING));
                        localValue4.resourceName = ("Deposit" + localValue2.externalResource_string);
                        this.inputList.addChild(localValue4);
                    };
                    localValue5 = new dResource();
                    localValue5.name_string = localValue2.defaultSetting.resourceName_string;
                    localValue5.amount = Math.abs((((localValue2.amountRemoved == 0) ? 1 : localValue2.amountRemoved) * this.chain.getProductivityOutput()));
                    this.outputResourceIcon.data = localValue5;
                }
                else
                {
                    localValue4 = new ResourceIconRenderer();
                    localValue4.resourceName = "Seed";
