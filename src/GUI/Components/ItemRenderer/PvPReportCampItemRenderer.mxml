<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" width="25" height="29">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import mx.controls.Image;
        import GUI.Components.CustomLabel;
        import mx.core.mx_internal;
        import flash.filters.DropShadowFilter;
        import flash.events.MouseEvent;
        import mx.events.FlexEvent;
        import mx.events.PropertyChangeEvent;
        import flash.events.Event;
        import GUI.Assets.gAssetManager;
        import flash.display.DisplayObjectContainer;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.IEventDispatcher;

        public static const CAMP_CLICK:String = "campClick";

        private var campTypeImage:Class;

        private var backGroundImageMO:Class;

        private var attackIndex:int;

        private var backGroundImageStd:Class;

        protected function canvas1_creationCompleteHandler(argument1:FlexEvent):void
        {
            this.addEventListener(MouseEvent.CLICK, this.clickHandler);
            this.addEventListener(MouseEvent.MOUSE_OVER, this.mouseOverHandler);
            this.addEventListener(MouseEvent.MOUSE_OUT, this.mouseOutHandler);
            if (this.attackIndex > 0)
            {
                this.attackNumber.text = this.attackIndex.toString();
            };
            this.campMarker.source = this.backGroundImageStd;
            this.campType.source = this.campTypeImage;
        }

        private function getCampType(argument1:String):String
        {
            if (((argument1.indexOf("ranged") >= 0) || (argument1.indexOf("Ranged") >= 0)))
            {
                return (defines.PLAYER_CAMP_TYPE_RANGED_string);
            };
            if (((argument1.indexOf("melee") >= 0) || (argument1.indexOf("Melee") >= 0)))
            {
                return (defines.PLAYER_CAMP_TYPE_MELEE_string);
            };
            if (((argument1.indexOf("cav") >= 0) || (argument1.indexOf("Cav") >= 0)))
            {
                return (defines.PLAYER_CAMP_TYPE_CAV_string);
            };
            if (((argument1.indexOf("mixed") >= 0) || (argument1.indexOf("Mixed") >= 0)))
            {
                return (defines.PLAYER_CAMP_TYPE_MIXED_string);
            };
            return (defines.PLAYER_CAMP_TYPE_MIXED_string);
        }

        protected function mouseOutHandler(argument1:MouseEvent):void
        {
            this.campMarker.source = this.backGroundImageStd;
        }

        protected function clickHandler(argument1:MouseEvent):void
        {
            dispatchEvent(new Event(CAMP_CLICK, true, true));
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            if (data != null)
            {
                if (data.timestamp > 0)
                {
                    this.backGroundImageStd = gAssetManager.GetClass("PvPReportCampMarkerStandard");
                    this.backGroundImageMO = gAssetManager.GetClass("PvPReportCampMarkerMouseOver");
                    if (data.index != null)
                    {
                        this.attackIndex = data.index;
                    };
                }
                else
                {
                    this.backGroundImageStd = gAssetManager.GetClass("PvPReportCampMarkerDisabled");
                    this.backGroundImageMO = gAssetManager.GetClass("PvPReportCampMarkerDisabled");
                };
                switch (this.getCampType(data.name))
                {
                    case defines.PLAYER_CAMP_TYPE_RANGED_string:
                    this.campTypeImage = gAssetManager.GetClass("IconRangedSmall");
                    break;
                    case defines.PLAYER_CAMP_TYPE_MELEE_string:
                    this.campTypeImage = gAssetManager.GetClass("IconMeleeSmall");
                    break;
                    case defines.PLAYER_CAMP_TYPE_CAV_string:
                    this.campTypeImage = gAssetManager.GetClass("IconCavalrySmall");
                    break;
                    case defines.PLAYER_CAMP_TYPE_MIXED_string:
                    this.campTypeImage = gAssetManager.GetClass("IconMixedSmall");
                    break;
                };
                this.campMarker.source = this.backGroundImageStd;
                this.campType.source = this.campTypeImage;
            };
            refreshRendererPresentation();
        }

        protected function mouseOverHandler(argument1:MouseEvent):void
        {
            this.campMarker.source = this.backGroundImageMO;
            var localValue2:DisplayObjectContainer = this.parent;
            localValue2.setChildIndex(this, (localValue2.numChildren - 1));
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.width = 25;
            this.height = 29;
            this.verticalScrollPolicy = "off";
            this.horizontalScrollPolicy = "off";

            this.addEventListener("creationComplete", this.canvas1_creationCompleteHandler);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:filters>
        <mx:DropShadowFilter id="viewDropShadowFilter1" alpha="0.6" />
    </mx:filters>
    <mx:Image id="campMarker" scaleContent="false" percentWidth="100" percentHeight="100" />
    <mx:Image id="campType" scaleContent="false" width="19" height="19"  top="3" left="3" />
    <ui:CustomLabel id="attackNumber" visible="false"  left="0" right="8" textAlign="center" bottom="6" fontWeight="bold" color="0xFFFFFF" />
</mx:Canvas>
