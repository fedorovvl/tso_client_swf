<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" width="60" height="60">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import mx.controls.Image;
        import GUI.Components.TSOImage;
        import mx.core.mx_internal;
        import GUI.Components.ToolTips.cToolTipUtil;
        import mx.events.ToolTipEvent;
        import GUI.Assets.gAssetManager;
        import mx.events.FlexEvent;
        import mx.events.PropertyChangeEvent;
        import ServerState.cPlayerData;
        import Enums.AVATAR_SIZE;
        import Interface.cGeneralInterface;
        import Communication.VO.dPlayerListItemVO;
        import flash.events.Event;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.IEventDispatcher;

        private var _colorIndex:int = 0;

        public var toolTipType:String = "Simple";

        public function GetColorIndex():int
        {
            return (this._colorIndex);
        }

        public function onAvatarListItemRenderer_Canvas1_toolTipCreate(argument1:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(this.toolTipType, argument1);
        }

        public function onAvatarListItemRenderer_Canvas1_creationComplete(argument1:FlexEvent):void
        {
            this.Initialize();
        }

        private function Display(argument1:Event=null):void
        {
            this.removeEventListener(FlexEvent.CREATION_COMPLETE, this.Display);
            if ((data is cPlayerData))
            {
                this._colorIndex = (global.ui.mCurrentPlayerZone.GetPlayerColorIdx(data.GetPlayerId()) + 1);
                this.avatarBackground.source = gAssetManager.GetBitmap(("AvatarBackgroundSmall0" + this._colorIndex));
                this.avatar.source = gAssetManager.GetAvatarUrl(data.GetAvatarId(), AVATAR_SIZE.SMALL);
                toolTip = cGeneralInterface.getComputedPlayerName(cPlayerData(data).GetPlayerName_string());
            }
            else
            {
                if ((data is dPlayerListItemVO))
                {
                    this._colorIndex = (global.ui.mCurrentPlayerZone.GetPlayerColorIdx(data.id) + 1);
                    this.avatarBackground.source = gAssetManager.GetBitmap(((this._colorIndex < 10) ? ("AvatarBackgroundSmall0" + this._colorIndex) : ("AvatarBackgroundSmall" + this._colorIndex)));
                    if (data.avatarId < 0)
                    {
                        this.avatar.source = gAssetManager.GetBitmap(((Math.abs(data.avatarId) < 10) ? ("AvatarBanditSmall0" + Math.abs(data.avatarId)) : ("AvatarBanditSmall" + Math.abs(data.avatarId))));
                    }
                    else
                    {
                        this.avatar.source = gAssetManager.GetAvatarUrl(data.avatarId, AVATAR_SIZE.SMALL);
                    };
                    toolTip = cGeneralInterface.getComputedPlayerName(data.username);
                    this.toolTipType = cToolTipUtil.SIMPLE_string;
                };
            };
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            if (((this.avatarBackground) && (this.avatar)))
            {
                this.Display();
            }
            else
            {
                this.addEventListener(FlexEvent.CREATION_COMPLETE, this.Display);
            };
            refreshRendererPresentation();
        }

        protected function Initialize():void
        {
            if (data != null)
            {
                return;
            };
            this.avatarBackground.source = gAssetManager.GetBitmap("AvatarBackgroundSmall13");
            this.avatar.source = gAssetManager.GetBitmap("AvatarSmall00");
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            configuredImage2.source = gAssetManager.GetBitmap("AvatarBackgroundSmall00");
            this.width = 60;
            this.height = 60;
            this.addEventListener("creationComplete", this.onAvatarListItemRenderer_Canvas1_creationComplete);
            this.addEventListener("toolTipCreate", this.onAvatarListItemRenderer_Canvas1_toolTipCreate);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:Image id="avatarBackground" width="60" height="60" scaleContent="false" />
    <ui:TSOImage id="avatar" width="60" height="60" scaleContent="false" />
    <mx:Image id="configuredImage2" percentWidth="100" percentHeight="100" scaleContent="false" />
</mx:Canvas>
