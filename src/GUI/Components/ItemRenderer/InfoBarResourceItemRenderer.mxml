<?xml version="1.0" encoding="utf-8"?>
<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*">
    <mx:Script><![CDATA[
        import mx.containers.HBox;
        import flash.filters.GlowFilter;
        import mx.controls.Image;
        import GUI.Components.CustomLabel;
        import mx.core.mx_internal;
        import mx.styles.CSSStyleDeclaration;
        import mx.events.PropertyChangeEvent;
        import flash.events.MouseEvent;
        import GUI.Effects.gGlowManager;
        import GUI.Components.ToolTips.cToolTipUtil;
        import mx.events.ToolTipEvent;
        import mx.events.FlexEvent;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        private static var glowFilter:GlowFilter = new GlowFilter(0xC1001D, 1, 14, 14, 6);

        private function genLabel(argument1:int, argument2:int):String
        {
            if (argument2 < 0)
            {
                return (argument1.toString());
            };
            return ((argument1 + "/") + argument2);
        }

        protected function clickHandler(argument1:MouseEvent):void
        {
            if (toolTip == "ZoneBuffs")
            {
                globalFlash.gui.mZoneBuffPanel.Show();
            };
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            if ((((data) && (data.hasOwnProperty("glow"))) && (data["glow"] === true)))
            {
                gGlowManager.addElementWithGlow(this.iconDisplay, glowFilter);
            }
            else
            {
                gGlowManager.removeElement(this.iconDisplay);
            };
            refreshRendererPresentation();
        }

        private function createToolTipCreateHandler(argument1:ToolTipEvent):void
        {
            if (toolTip == "Population")
            {
                cToolTipUtil.createToolTip(cToolTipUtil.POPULATION_OVERVIEW_string, argument1);
                global.ui.mQuestClientCallbacks.InitiateWindowOpen("PopulationTooltip");
                global.getApplication().inputNotifier.notifyClick("PopulationTooltip");
            }
            else
            {
                if (toolTip == "ZoneBuffs")
                {
                    cToolTipUtil.createToolTip(cToolTipUtil.ZONE_BUFF_string, argument1);
                }
                else
                {
                    cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_string, argument1);
                };
            };
        }

        protected function creationCompleteHandler(argument1:FlexEvent):void
        {
            this.addEventListener(MouseEvent.CLICK, this.clickHandler);
        }

        private function readPresentationValue1():String
        {
            var localValue1:* = data.toolTip;
            return ((localValue1 == undefined) ? null : String(localValue1));
        }

        private function readPresentationValue5():String
        {
            var localValue1:* = genLabel(data.amount, data.limit);
            return ((localValue1 == undefined) ? null : String(localValue1));
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.setStyle("horizontalGap", 2);
            this.setStyle("verticalAlign", "middle");
            this.mouseChildren = false;
            this.addEventListener("creationComplete", this.creationCompleteHandler);
            this.addEventListener("toolTipCreate", this.createToolTipCreateHandler);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);
                if (data != null)
                {
                    this.toolTip = readPresentationValue1();
                }
                if (data != null)
                {
                    this.visible = data.visible;
                }
                if (data != null)
                {
                    this.includeInLayout = data.visible;
                }
                if (data != null)
                {
                    iconDisplay.source = data.icon;
                }
                if (data != null)
                {
                    labelDisplay.text = readPresentationValue5();
                }
            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:Image id="iconDisplay" />
    <ui:CustomLabel id="labelDisplay"  color="0xFFFFFF" fontWeight="bold" />
</mx:HBox>
