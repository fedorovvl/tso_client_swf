<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" width="180" height="73">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import GUI.Components.TSOImage;
        import GUI.Components.CustomLabel;
        import GUI.Loca.cLocaManager;
        import mx.core.mx_internal;
        import mx.styles.CSSStyleDeclaration;
        import mx.events.PropertyChangeEvent;
        import GUI.Assets.gAssetManager;
        import mx.events.FlexEvent;
        import Communication.VO.UpdateVO.dAdventureClientInfoVO;
        import AdventureSystem.cAdventureDefinition;
        import AdventureSystem.cAdventure;
        import com.bluebyte.tso.util.TimeUtil;
        import Enums.LOCA_GROUP;
        import flash.events.Event;
        import Communication.VO.dPlayerListItemVO;
        import flash.events.MouseEvent;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.IEventDispatcher;

        private var lm:cLocaManager = cLocaManager.GetInstance();

        private function display(argument1:Event=null):void
        {
            removeEventListener(FlexEvent.CREATION_COMPLETE, this.display);
            var localValue2:dAdventureClientInfoVO = (data as dAdventureClientInfoVO);
            var localValue3:cAdventureDefinition = cAdventureDefinition.FindAdventureDefinition(localValue2.adventureName);
            var localValue4:Number = cAdventure.GetAdventureDuration(global.ui, localValue3, (TimeUtil.getServerTime() - localValue2.collectedTime), localValue2.totalDuration);
            this.image.source = localValue3.GetAvatarImage();
            this.lblName.text = this.lm.GetText(LOCA_GROUP.ADVENTURE_NAME, localValue2.adventureName);
            this.lblDuration.text = this.lm.FormatDuration((localValue4 - localValue2.collectedTime), cLocaManager.DURATION_FORMAT_NUMERIC);
            var localValue5:String = cAdventureDefinition.FindAdventureDefinition(localValue2.adventureName).GetType_string();
            this.imageIcon.source = gAssetManager.ColorFilterImage(gAssetManager.GetBitmap(("adventureType" + localValue5)), cAdventureDefinition.GetDifficultyColor(localValue3.GetDifficulty()));
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            super.data = argument1;
            if (this.image)
            {
                this.display();
            }
            else
            {
                addEventListener(FlexEvent.CREATION_COMPLETE, this.display);
            };
            refreshRendererPresentation();
        }

        private function clickHandler(argument1:MouseEvent):void
        {
            var localValue2:dPlayerListItemVO = new dPlayerListItemVO();
            localValue2.adventureVO = (data as dAdventureClientInfoVO);
            localValue2.id = localValue2.adventureVO.zoneID;
            globalFlash.gui.ShowFriendListMenu(argument1, localValue2);
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.setStyle("backgroundSize", "100%");
            this.setStyle("backgroundImage", gAssetManager.GetClass("TrackedAdventureBackground"));
            this.width = 180;
            this.height = 73;
            this.addEventListener("click", this.clickHandler);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <ui:TSOImage id="image"  left="15" top="2" />
    <ui:TSOImage id="imageIcon"  left="47" top="27" />
    <ui:CustomLabel id="lblName" width="146"  color="0xFFFFFF" top="51" right="17" fontWeight="bold" />
    <ui:CustomLabel id="lblDuration" mouseEnabled="false"  color="0xFFFFFF" right="17" top="6" fontWeight="bold" />
</mx:Canvas>
