<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" xmlns:core="mx.core.*" width="30" height="50">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import GUI.Components.CustomList;
        import mx.core.mx_internal;
        import mx.core.ClassFactory;
        import mx.events.PropertyChangeEvent;
        import nLib.cLog;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            var localValue2:Array;
            super.data = argument1;
            this.slotRight.dataProvider = null;
            this.slotCenter.dataProvider = null;
            this.slotLeft.dataProvider = null;
            if (argument1 != null)
            {
                localValue2 = (data as Array);
                switch (localValue2.length)
                {
                    case 3:
                    this.slotRight.dataProvider = new Array(localValue2[2]);
                    case 2:
                    this.slotCenter.dataProvider = new Array(localValue2[1]);
                    case 1:
                    this.slotLeft.dataProvider = new Array(localValue2[0]);
                    return;
                    default:
                    if (cLog.isInfoEnabled())
                    {
                        cLog.info("error: Length of the list of hired Troops can only be 1, 2 or 3");
                    };
                };
            };
            refreshRendererPresentation();
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            viewClassFactory1.generator = HiredUnitsItemRenderer;
            viewClassFactory2.generator = HiredUnitsItemRenderer;
            viewClassFactory3.generator = HiredUnitsItemRenderer;
            this.horizontalScrollPolicy = "off";
            this.verticalScrollPolicy = "off";
            this.width = 30;
            this.height = 50;
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:Canvas id="viewCanvas1">
        <ui:CustomList id="slotLeft" horizontalScrollPolicy="off" verticalScrollPolicy="auto" selectable="false" paddingLeft="0" paddingTop="0" paddingRight="0" paddingBottom="0" backgroundAlpha="0" left="5" borderThickness="0">
            <ui:itemRenderer>
                <core:ClassFactory id="viewClassFactory1" />
            </ui:itemRenderer>
        </ui:CustomList>
        <ui:CustomList id="slotCenter" horizontalScrollPolicy="off" verticalScrollPolicy="auto" selectable="false" paddingLeft="0" paddingTop="0" paddingRight="0" paddingBottom="0" backgroundAlpha="0" left="50" borderThickness="0">
            <ui:itemRenderer>
                <core:ClassFactory id="viewClassFactory2" />
            </ui:itemRenderer>
        </ui:CustomList>
        <ui:CustomList id="slotRight" horizontalScrollPolicy="off" verticalScrollPolicy="auto" selectable="false" paddingLeft="0" paddingTop="0" paddingRight="0" paddingBottom="0" backgroundAlpha="0" left="95" borderThickness="0">
            <ui:itemRenderer>
                <core:ClassFactory id="viewClassFactory3" />
            </ui:itemRenderer>
        </ui:CustomList>
    </mx:Canvas>
</mx:Canvas>
