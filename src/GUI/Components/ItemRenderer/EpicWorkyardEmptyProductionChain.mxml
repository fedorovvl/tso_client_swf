<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" xmlns:ui="GUI.Components.*" width="185">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import GUI.Components.ButtonWithoutKeyboard;
        import mx.controls.Image;
        import mx.controls.Label;
        import mx.core.mx_internal;
        import EpicWorkyard.EpicWorkyardConsts;
        import GUI.Loca.cLocaManager;
        import Enums.LOCA_GROUP;
        import GUI.Assets.gAssetManager;
        import GUI.Components.ToolTips.cToolTipUtil;
        import mx.events.ToolTipEvent;
        import mx.events.PropertyChangeEvent;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        public function onBtnStartProduction_toolTipCreate(argument1:ToolTipEvent):void
        {
            cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_string, argument1);
        }

        private function readPresentationValue2():String
        {
            var localValue1:* = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "Production");
            return ((localValue1 == undefined) ? null : String(localValue1));
        }

        private function readPresentationValue4():String
        {
            var localValue1:* = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "StartProduction");
            return ((localValue1 == undefined) ? null : String(localValue1));
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            btnStartProduction.addEventListener("toolTipCreate", onBtnStartProduction_toolTipCreate);
            houseImage.source = gAssetManager.GetBitmap("HouseBg");
            this.width = 185;
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);
                this.height = EpicWorkyardConsts.PRODUCTION_CHAIN_RENDERER_HEIGHT;
                configuredLabel1.text = readPresentationValue2();
                btnStartProduction.label = readPresentationValue4();
            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:Canvas id="viewCanvas1" styleName="detailsSubHeader" percentWidth="100" height="18">
        <mx:Label id="configuredLabel1"  top="1" horizontalCenter="0" fontWeight="bold" />
    </mx:Canvas>
    <mx:Canvas id="viewCanvas2" styleName="detailsContentBox" height="97"  left="1" right="1" top="18" />
    <mx:Canvas id="viewCanvas3" styleName="detailsContentBox" height="162" left="1" right="1" top="115">
        <mx:Canvas id="viewCanvas4" styleName="generalButtonBg" percentWidth="100" height="62" />
        <mx:Image id="houseImage"  horizontalCenter="0" bottom="40" />
        <ui:ButtonWithoutKeyboard id="btnStartProduction" width="160" height="30"  horizontalCenter="0" bottom="5" />
    </mx:Canvas>
</mx:Canvas>
