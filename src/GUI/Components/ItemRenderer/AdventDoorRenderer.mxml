<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:local="GUI.Components.ItemRenderer.*" width="95" height="100">
    <mx:Script><![CDATA[
        import mx.containers.Canvas;
        import GUI.Assets.Animation;
        import mx.controls.Image;
        import Communication.VO.dAdventCalendarDoorVO;
        import mx.controls.Label;
        import flash.filters.GlowFilter;
        import mx.core.mx_internal;
        import mx.styles.CSSStyleDeclaration;
        import mx.events.PropertyChangeEvent;
        import GUI.Decorator.GUIDecorator;
        import GUI.Assets.gAssetManager;
        import Enums.ADVENT_CALENDAR_DOOR_BACKGROUND;
        import flash.display.Bitmap;
        import flash.events.MouseEvent;
        import mx.events.ToolTipEvent;
        import GUI.Components.ToolTips.cToolTipUtil;
        import Effects.EffectFactory;
        import Interface.cGameInterface;
        import GUI.FloatingItemsManager;
        import GUI.DataEvent;
        import nLib.cXML;
        import Enums.ADVENT_CALENDAR_DOOR_STATUS;
        import Enums.ADVENT_CALENDAR_DOOR_SPECIAL_TYPE;
        import com.bluebyte.tso.util.TimeUtil;
        import GUI.Loca.cLocaManager;
        import flash.events.*;
        import flash.display.*;
        import flash.geom.*;
        import mx.styles.*;
        import flash.text.*;
        import flash.media.*;
        import mx.binding.*;
        import flash.filters.*;
        import flash.utils.*;
        import flash.net.*;
        import flash.system.*;
        import flash.accessibility.*;
        import flash.xml.*;
        import flash.ui.*;
        import flash.external.*;
        import flash.desktop.*;
        import flash.data.*;
        import flash.debugger.*;
        import flash.errors.*;
        import flash.filesystem.*;
        import flash.html.*;
        import flash.html.script.*;
        import flash.printing.*;
        import flash.profiler.*;
        import GUI.Components.RendererPresentationUpdates;
        import flash.events.Event;
        import flash.events.IEventDispatcher;

        public static const DOOR_SELECTED:String = "DOOR_SELECTED";

        private static const RegularClosed:String = "RegularWindowClosed";

        private static const RegularOpened:String = "RegularWindowOpened";

        private static const SilvesterClosed:String = "SilvesterWindowClosed";

        private static const SilvesterOpened:String = "SilvesterWindowOpened";

        private static const SpecialClosed:String = "SpecialWindowClosed";

        private static const SpecialOpened:String = "SpecialWindowOpened";

        private static const XmasClosed:String = "XmasWindowClosed";

        private static const XmasOpened:String = "XmasWindowOpened";

        private static const WMEventAdventureClosed:String = "WMEventAdventureClosed";

        private static const WMEventAdventureOpened:String = "WMEventAdventureOpened";

        private static const WMEventBonusClosed:String = "WMEventBonusClosed";

        private static const WMEventBonusOpened:String = "WMEventBonusOpened";

        private static const PresentsClosed:String = "PresentsWindowClosed";

        private static const PresentsOpened:String = "PresentsWindowOpened";

        private static var animation:Animation;

        private var _waiting:Boolean = false;

        private var toolTipType:String = null;

        public var vo:dAdventCalendarDoorVO;

        private const HOVER_GLOW:GlowFilter = new GlowFilter(0xAAAA00, 0.6);

        private const OPENABLE_GLOW:GlowFilter = new GlowFilter(12303172, 1.4, 12, 12);

        public function set waiting(argument1:Boolean):void
        {
            this._waiting = argument1;
            if (argument1)
            {
                GUIDecorator.greyFilter(this.bg);
            };
        }

        private function getBG(argument1:int, argument2:Boolean):Bitmap
        {
            switch (argument1)
            {
                case ADVENT_CALENDAR_DOOR_BACKGROUND.NORMAL:
                if (argument2)
                {
                    return (gAssetManager.GetBitmap(RegularOpened));
                };
                return (gAssetManager.GetBitmap(RegularClosed));
                case ADVENT_CALENDAR_DOOR_BACKGROUND.NEW_YEAR:
                if (argument2)
                {
                    return (gAssetManager.GetBitmap(SilvesterOpened));
                };
                return (gAssetManager.GetBitmap(SilvesterClosed));
                case ADVENT_CALENDAR_DOOR_BACKGROUND.ADVENT:
                if (argument2)
                {
                    return (gAssetManager.GetBitmap(SpecialOpened));
                };
                return (gAssetManager.GetBitmap(SpecialClosed));
                case ADVENT_CALENDAR_DOOR_BACKGROUND.CHRISTMAS_EVE:
                if (argument2)
                {
                    return (gAssetManager.GetBitmap(XmasOpened));
                };
                return (gAssetManager.GetBitmap(XmasClosed));
                case ADVENT_CALENDAR_DOOR_BACKGROUND.WM_EVENT_ADVENTURE:
                if (argument2)
                {
                    return (gAssetManager.GetBitmap(WMEventAdventureOpened));
                };
                return (gAssetManager.GetBitmap(WMEventAdventureClosed));
                case ADVENT_CALENDAR_DOOR_BACKGROUND.WM_EVENT_BONUS:
                if (argument2)
                {
                    return (gAssetManager.GetBitmap(WMEventBonusOpened));
                };
                return (gAssetManager.GetBitmap(WMEventBonusClosed));
                case ADVENT_CALENDAR_DOOR_BACKGROUND.PRESENTS:
                if (argument2)
                {
                    return (gAssetManager.GetBitmap(PresentsOpened));
                };
                return (gAssetManager.GetBitmap(PresentsClosed));
            };
            return (gAssetManager.GetBitmap("noAdventDoorGFX"));
        }

        protected function canvas1_mouseOverHandler(argument1:MouseEvent):void
        {
            GUIDecorator.addFilter(this.bg, this.HOVER_GLOW);
        }

        private function CreateToolTip(argument1:ToolTipEvent):void
        {
            if (toolTip == "AdventCalendarDoorGemOpenTip")
            {
                cToolTipUtil.createToolTip(cToolTipUtil.ADVENT_CALENDAR_DOOR_string, argument1, this.vo);
            }
            else
            {
                if (toolTip == "AdventCalendarDoorAllPreviousTip")
                {
                    cToolTipUtil.createToolTip(cToolTipUtil.SIMPLE_string, argument1, "AdventCalendarDoorAllPreviousTip");
                };
            };
        }

        public function onAnimEnd():void
        {
            animation.parent.removeChild(animation);
            this.questionMark.visible = false;
            this.data = this.vo;
            this.item.data = new EffectFactory(cGameInterface(global.ui)).createEffect(this.vo.rewards[this.vo.chosenRewardId]);
            validateNow();
            FloatingItemsManager.createJumpFlyDestroy(this.item, "GAMESTATE_ID_ACTIONBAR.actionBarCenter.btnActionBar04");
        }

        protected function canvas1_mouseOutHandler(argument1:MouseEvent):void
        {
            GUIDecorator.removeFilter(this.bg, this.HOVER_GLOW);
        }

        public function open():void
        {
            animation.onAnimationEnd = this.onAnimEnd;
            addChild(animation);
            animation.play();
        }

        protected function canvas1_clickHandler(argument1:MouseEvent):void
        {
            if (!this._waiting)
            {
                dispatchEvent(new GUI.DataEvent(DOOR_SELECTED, data));
            };
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            if (argument1 == null)
            {
                return;
            };
            if (animation == null)
            {
                animation = new Animation();
                animation.xml = cXML.getFirstChildBasedOnAttribute(global.textureAtlas, "imagePath", "summerevent_sparkle.png");
                animation.x = (this.bg.x + 13);
                animation.y = this.bg.y;
            };
            this.vo = (argument1 as dAdventCalendarDoorVO);
            this.bg.filters = [];
            var localValue2:Boolean = ((this.vo.chosenRewardId >= 0) && ((ADVENT_CALENDAR_DOOR_STATUS.OPENED == this.vo.status) || (ADVENT_CALENDAR_DOOR_STATUS.OPENED_WITH_GEMS == this.vo.status)));
            this.bg.source = this.getBG(this.vo.backgroundType, localValue2);
            this.nr.source = gAssetManager.GetBitmapNumber(new Date(this.vo.openDateTimestamp).date, "CalendarDateDigit");
            this.gem.visible = (this.vo.status == ADVENT_CALENDAR_DOOR_STATUS.CAN_OPEN_WITH_GEMS);
            this.questionMark.visible = true;
            this.item.visible = false;
            if (localValue2)
            {
                this.questionMark.visible = false;
                this.item.data = new EffectFactory(cGameInterface(global.ui)).createEffect(this.vo.rewards[this.vo.chosenRewardId]);
                this.item.visible = true;
            }
            else
            {
                if (((this.gem.visible) || (this.vo.status == ADVENT_CALENDAR_DOOR_STATUS.CAN_OPEN)))
                {
                    GUIDecorator.addFilter(this.bg, this.OPENABLE_GLOW);
                };
            };
            toolTip = "";
            if (this.vo.status == ADVENT_CALENDAR_DOOR_STATUS.CAN_OPEN_WITH_GEMS)
            {
                toolTip = "AdventCalendarDoorGemOpenTip";
            }
            else
            {
                if (((this.vo.specialType == ADVENT_CALENDAR_DOOR_SPECIAL_TYPE.ALL_PREVIOUS_NEEDED) && (!((this.vo.status == ADVENT_CALENDAR_DOOR_STATUS.OPENED) || (this.vo.status == ADVENT_CALENDAR_DOOR_STATUS.OPENED_WITH_GEMS)))))
                {
                    toolTip = "AdventCalendarDoorAllPreviousTip";
                };
            };
            super.data = argument1;
            var localValue3:Date = new Date();
            localValue3.time = this.vo.openDateTimestamp;
            localValue3.date = (localValue3.date + 1);
            var localValue4:Number = (localValue3.time - TimeUtil.getServerTime());
            if (((localValue4 > 0) && (localValue4 < 86400000)))
            {
                this.timeRemainingLabel.text = cLocaManager.GetInstance().FormatDuration(localValue4, cLocaManager.DURATION_FORMAT_SHORT);
            };
            refreshRendererPresentation();
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.setStyle("backgroundAlpha", 0);
            gem.source = gAssetManager.GetBitmap("SmallIconHardCurrency");
            questionMark.source = gAssetManager.GetBitmap("QuestionmarkGold");
            this.width = 95;
            this.height = 100;
            this.addEventListener("click", this.canvas1_clickHandler);
            this.addEventListener("rollOver", this.canvas1_mouseOverHandler);
            this.addEventListener("rollOut", this.canvas1_mouseOutHandler);
            this.addEventListener("toolTipCreate", this.CreateToolTip);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <mx:Image id="bg"  horizontalCenter="0" verticalCenter="0" />
    <mx:Image id="gem"  left="8" top="10" />
    <mx:Image id="nr" scaleX="1" scaleY="1"  horizontalCenter="0" bottom="16" />
    <mx:Image id="questionMark"  horizontalCenter="0" verticalCenter="-12" />
    <mx:Label id="timeRemainingLabel" height="10"  bottom="2" left="0" right="0" textAlign="center" color="0xFFFFFF" />
    <local:RenderableItemRenderer id="item" visible="false" />
</mx:Canvas>
