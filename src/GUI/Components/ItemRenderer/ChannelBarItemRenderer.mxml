        private function onTimer(argument1:TimerEvent):void
        {
            if (this.styleName == StyleManager.getStyleDeclaration(".chatTabNewMessage"))
            {
                this.styleName = StyleManager.getStyleDeclaration(".chatTab");
            }
            else
            {
                if (this.styleName == StyleManager.getStyleDeclaration(".chatTab"))
                {
                    this.styleName = StyleManager.getStyleDeclaration(".chatTabNewMessage");
                };
            };
        }

        override public function set data(argument1:Object):void
        {
            if (!rendererReady)
            {
                pendingRendererData = argument1;
                hasPendingRendererData = true;
                return;
            }
            var localValue2:int;
            var localValue3:String;
            var localValue4:String;
            var localValue5:String;
            super.data = argument1;
            if (!this._timer)
            {
                this._timer = new Timer(1000, localValue2);
            };
            localValue2 = 6;
            if ((argument1 as ChannelVO).name == "whisper")
            {
                localValue2 = 0;
            };
            this._timer.repeatCount = localValue2;
            if (this._changeWatcher)
            {
                this._changeWatcher.unwatch();
            };
            this._changeWatcher = ChangeWatcher.watch(super.data, "newMessages", this.handleNewMessageChange);
            if ((argument1 is ChannelVO))
            {
                if (ChannelBar(owner).selectedItem == data)
                {
                    this.styleName = StyleManager.getStyleDeclaration(".chatTabSelected");
                }
                else
                {
                    if (ChannelVO(data).newMessages)
                    {
                        this.styleName = StyleManager.getStyleDeclaration(".chatTabNewMessage");
                    }
                    else
                    {
                        this.styleName = StyleManager.getStyleDeclaration(".chatTab");
                        if (this._timer)
                        {
                            this._timer.stop();
                        };
                    };
                };
                localValue3 = (argument1 as ChannelVO).name;
                localValue4 = (argument1 as ChannelVO).label;
                if (((!(localValue3 == null)) && (!(localValue4 == null))))
                {
                    if (localValue3.indexOf("global") == 0)
                    {
                        this.channelIcon.source = gAssetManager.GetClass(CHAT_TAB_ICON.GLOBAL);
                        toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "ChatGlobal");
                    }
                    else
                    {
                        if (localValue3.indexOf("help") == 0)
                        {
                            this.channelIcon.source = gAssetManager.GetClass(CHAT_TAB_ICON.HELP);
                            toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "ChatHelp");
                        }
                        else
                        {
                            if (localValue3.indexOf("trade") == 0)
                            {
                                this.channelIcon.source = gAssetManager.GetClass(CHAT_TAB_ICON.TRADE);
                                toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "ChatTrade");
                            }
                            else
                            {
                                if (localValue3.indexOf("gco") == 0)
                                {
                                    this.channelIcon.source = gAssetManager.GetClass(CHAT_TAB_ICON.GUILD_OFFICER);
                                    toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "ChatOfficers");
                                }
                                else
                                {
                                    if (localValue3.indexOf("gc") == 0)
                                    {
                                        this.channelIcon.source = gAssetManager.GetClass(CHAT_TAB_ICON.GUILD);
                                        toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "ChatGuild");
                                    }
                                    else
                                    {
                                        if (localValue3.indexOf("whisper") == 0)
                                        {
                                            this.channelIcon.source = gAssetManager.GetClass(CHAT_TAB_ICON.WHISPER);
                                            toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "ChatWhisper");
                                        }
                                        else
                                        {
                                            if (localValue3.indexOf("news") == 0)
                                            {
                                                this.channelIcon.source = gAssetManager.GetClass(CHAT_TAB_ICON.NEWS);
                                                toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "ChatNews");
                                            }
                                            else
                                            {
                                                if (localValue4.indexOf("myAdv") == 0)
                                                {
                                                    this.channelIcon.source = gAssetManager.GetClass(CHAT_TAB_ICON.ADVENTURE);
                                                    localValue5 = localValue4.substr(5, (localValue4.length - 5));
                                                    toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.ADVENTURE_NAME, localValue5);
                                                }
                                                else
                                                {
                                                    if (localValue4.indexOf("frAdv") == 0)
                                                    {
                                                        this.channelIcon.source = gAssetManager.GetClass(CHAT_TAB_ICON.COOP_ADVENTURE);
                                                        localValue5 = localValue4.substr(5, (localValue4.length - 5));
                                                        toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.ADVENTURE_NAME, localValue5);
                                                    }
                                                    else
                                                    {
                                                        if (localValue3.indexOf("find") == 0)
                                                        {
                                                            this.channelIcon.source = gAssetManager.GetClass(CHAT_TAB_ICON.FINDCOOP);
                                                            toolTip = cLocaManager.GetInstance().GetText(LOCA_GROUP.LABELS, "ChatFindcooperation");
                                                        };
                                                    };
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
            refreshRendererPresentation();
        }

        private function HandleRemoveClick(argument1:Event):void
        {
            this.dispatchEvent(new ListEvent(PRIVATE_LIST_REMOVE, true, false, 0, TileList(owner).dataProvider.getItemIndex(data)));
            argument1.stopImmediatePropagation();
            argument1.preventDefault();
        }

        private function handleNewMessageChange(argument1:PropertyChangeEvent):void
        {
            if (argument1.newValue)
            {
                this._timer.reset();
                this._timer.start();
            }
            else
            {
                this._timer.stop();
            };
        }

        private var rendererReady:Boolean = false;
        private var pendingRendererData:Object;
        private var hasPendingRendererData:Boolean = false;
        private var rendererPresentationUpdating:Boolean = false;
        private var rendererUpdates:RendererPresentationUpdates;

        override protected function childrenCreated():void
        {
            super.childrenCreated();
            this.setStyle("verticalCenter", 0);
            this.setStyle("backgroundAlpha", 1);
            this.setStyle("backgroundSize", "100%");
            channelIcon.addEventListener("toolTipCreate", onChannelIcon_toolTipCreate);
            this.percentHeight = 50;
            this.minWidth = 50;
            this.maxWidth = 75;
            this.addEventListener("creationComplete", this.canvas1_creationCompleteHandler);
            rendererReady = true;
            rendererUpdates = new RendererPresentationUpdates(this, refreshRendererPresentation);
            if (hasPendingRendererData)
            {
                var initialData:Object = pendingRendererData;
                hasPendingRendererData = false;
                pendingRendererData = null;
                data = initialData;
            }
            refreshRendererPresentation();
        }

        private function refreshRendererPresentation():void
        {
            if (!rendererReady || rendererPresentationUpdating) return;
            rendererPresentationUpdating = true;
            try
            {
                rendererUpdates.observe([[data, "propertyChange"]]);

            }
            finally
            {
                rendererPresentationUpdating = false;
            }
        }
    ]]></mx:Script>

    <ui:TSOImage id="channelIcon" width="20" height="20"  left="8" />
